{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saariuslystoned.github.io/SaariusSkills/herdr-puppet/plan.schema.json",
  "title": "Herdr-Puppet plan v1",
  "type": "object",
  "required": [
    "schema",
    "state",
    "run_id",
    "harness",
    "session",
    "workspace",
    "destination_selection",
    "expected_ssh_target",
    "owned_label",
    "source",
    "harness_binding",
    "proof_root",
    "safety"
  ],
  "properties": {
    "schema": {"const": "herdr-puppet.plan.v1"},
    "state": {"const": "planned"},
    "run_id": {"type": "string", "minLength": 1},
    "harness": {"enum": ["agy", "codex", "claude", "cursor", "grok"]},
    "session": {
      "type": "object",
      "required": ["name", "version", "protocol", "socket", "incarnation_proven"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "protocol": {"type": "integer", "minimum": 1},
        "socket": {"type": "string", "minLength": 1},
        "incarnation_proven": {"const": false}
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "destination_selection": {"$ref": "#/$defs/destinationSelection"},
    "expected_ssh_target": {"type": "string", "minLength": 1},
    "owned_label": {"type": "string", "pattern": "^puppet-[a-z0-9-]+$"},
    "source": {
      "type": "object",
      "required": ["repo", "worktree"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "harness_binding": {
      "oneOf": [
        {"$ref": "harness-binding.schema.json"},
        {"$ref": "harness-binding-v2.schema.json"},
        {"$ref": "harness-binding-v1.schema.json"}
      ]
    },
    "proof_root": {"type": "string", "minLength": 1},
    "safety": {
      "type": "object",
      "required": [
        "parent_session_mutation",
        "adopt_existing_tab",
        "ordinary_transcript_read",
        "live_mutation_authorized"
      ],
      "properties": {
        "parent_session_mutation": {"const": false},
        "adopt_existing_tab": {"const": false},
        "ordinary_transcript_read": {"const": false},
        "live_mutation_authorized": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "destinationSelection": {
      "type": "object",
      "required": [
        "schema",
        "mode",
        "machine",
        "workspace_label",
        "tab",
        "legacy_ordinal_alias",
        "catalog_path_retained",
        "ssh_target_retained",
        "existing_tab_adoption"
      ],
      "properties": {
        "schema": {"const": "herdr-puppet.destination-selection-receipt.v1"},
        "mode": {"enum": ["named_catalog", "legacy_explicit"]},
        "machine": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "workspace_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "tab": {
          "type": "object",
          "required": ["request", "ordinal"],
          "properties": {
            "request": {"const": "fresh"},
            "ordinal": {"type": "integer", "minimum": 1, "maximum": 999}
          },
          "additionalProperties": false
        },
        "legacy_ordinal_alias": {"type": "boolean"},
        "catalog_path_retained": {"const": false},
        "ssh_target_retained": {"const": false},
        "existing_tab_adoption": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "named_catalog"}}},
          "then": {
            "properties": {
              "machine": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          },
          "else": {"properties": {"machine": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
