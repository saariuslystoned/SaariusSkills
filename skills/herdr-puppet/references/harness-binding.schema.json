{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saariuslystoned.github.io/SaariusSkills/herdr-puppet/harness-binding.schema.json",
  "title": "Herdr-Puppet controller-attested harness binding v1",
  "type": "object",
  "required": [
    "schema",
    "harness",
    "remote",
    "profile",
    "model_observation",
    "regular_launch",
    "adapters",
    "source",
    "instructions",
    "capabilities",
    "attestation",
    "fingerprint"
  ],
  "properties": {
    "schema": {"const": "herdr-puppet.harness-binding.v1"},
    "harness": {"enum": ["agy", "codex", "claude", "cursor", "grok"]},
    "remote": {
      "type": "object",
      "required": ["host", "executable"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "executable": {
          "type": "object",
          "required": [
            "command",
            "path",
            "version",
            "sha256",
            "version_sha256",
            "help_sha256",
            "fingerprint"
          ],
          "properties": {
            "command": {"type": "string", "minLength": 1},
            "path": {"type": "string", "pattern": "^/"},
            "version": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "version_sha256": {"$ref": "#/$defs/sha256"},
            "help_sha256": {"$ref": "#/$defs/sha256"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "route",
        "root",
        "isolation",
        "enrollment_state",
        "status_exit",
        "raw_output_retained"
      ],
      "properties": {
        "route": {"const": "dedicated_os_user_profile"},
        "root": {"type": "string", "pattern": "^/"},
        "isolation": {"const": "dedicated_remote_user"},
        "enrollment_state": {"const": "enrolled"},
        "status_exit": {"const": 0},
        "raw_output_retained": {"const": false}
      },
      "additionalProperties": false
    },
    "model_observation": {
      "type": "object",
      "required": ["selection", "model", "effort"],
      "properties": {
        "selection": {"const": "current_default"},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "regular_launch": {
      "type": "object",
      "required": [
        "argv",
        "environment",
        "unrestricted",
        "explicit_model_selector",
        "vector_sha256"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "environment": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "unrestricted": {"const": true},
        "explicit_model_selector": {"const": false},
        "vector_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "required": [
        "harness_fingerprint",
        "transport_fingerprint",
        "protocol_fingerprint"
      ],
      "properties": {
        "harness_fingerprint": {"$ref": "#/$defs/sha256"},
        "transport_fingerprint": {"$ref": "#/$defs/sha256"},
        "protocol_fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["repo", "worktree"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "pattern": "^/"}
      },
      "additionalProperties": false
    },
    "instructions": {
      "type": "object",
      "required": ["schema", "plane", "policy_fingerprint", "layers"],
      "properties": {
        "schema": {"const": "herdr-puppet.instruction-wrapper.v1"},
        "plane": {"const": "initial_message_wrapper"},
        "policy_fingerprint": {"$ref": "#/$defs/sha256"},
        "layers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "const": {
        "remote_harness_pid": "unavailable",
        "targeted_halt": "unsupported",
        "recovery": "unsupported",
        "crash_persistence": "unsupported"
      }
    },
    "attestation": {
      "type": "object",
      "required": [
        "kind",
        "recorded_at",
        "census_recorded_at",
        "raw_output_retained"
      ],
      "properties": {
        "kind": {"const": "controller_attested"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "census_recorded_at": {"type": "string", "format": "date-time"},
        "raw_output_retained": {"const": false}
      },
      "additionalProperties": false
    },
    "fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
