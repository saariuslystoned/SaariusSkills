{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saariuslystoned.github.io/SaariusSkills/herdr-puppet/lease.schema.json",
  "title": "Herdr-Puppet lease v1",
  "type": "object",
  "required": [
    "schema",
    "state",
    "run_id",
    "harness",
    "session",
    "workspace",
    "owned_label",
    "tab_id",
    "pane_id",
    "terminal_id",
    "ssh",
    "next_seq",
    "source",
    "proof_root"
  ],
  "properties": {
    "schema": {"const": "herdr-puppet.lease.v1"},
    "state": {"enum": ["active", "preserved"]},
    "run_id": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "minLength": 1},
    "session": {"$ref": "#/$defs/session"},
    "workspace": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "owned_label": {"type": "string", "pattern": "^puppet-[a-z0-9-]+$"},
    "tab_id": {"type": "string", "minLength": 1},
    "pane_id": {"type": "string", "minLength": 1},
    "terminal_id": {"type": "string", "minLength": 1},
    "ssh": {
      "type": "object",
      "required": ["pid", "argv", "target"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string"}
        },
        "target": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "next_seq": {"type": "integer", "minimum": 1},
    "source": {
      "type": "object",
      "required": ["repo", "worktree"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "proof_root": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "session": {
      "type": "object",
      "required": ["name", "version", "protocol", "socket", "incarnation_proven"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "protocol": {"type": "integer", "minimum": 1},
        "socket": {"type": "string", "minLength": 1},
        "incarnation_proven": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
