{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saariuslystoned.github.io/SaariusSkills/herdr-puppet/lease.schema.json",
  "title": "Herdr-Puppet lease v1",
  "type": "object",
  "required": [
    "schema",
    "state",
    "run_id",
    "harness",
    "session",
    "workspace",
    "owned_label",
    "tab_id",
    "pane_id",
    "terminal_id",
    "ssh",
    "next_seq",
    "shell_readiness",
    "harness_readiness",
    "source",
    "proof_root",
    "caller_text_files",
    "caller_text_files_removed",
    "remote_task_files"
  ],
  "properties": {
    "schema": {"const": "herdr-puppet.lease.v1"},
    "state": {"enum": ["active", "preserved"]},
    "run_id": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "minLength": 1},
    "session": {"$ref": "#/$defs/session"},
    "workspace": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "owned_label": {"type": "string", "pattern": "^puppet-[a-z0-9-]+$"},
    "tab_id": {"type": "string", "minLength": 1},
    "pane_id": {"type": "string", "minLength": 1},
    "terminal_id": {"type": "string", "minLength": 1},
    "ssh": {
      "type": "object",
      "required": ["pid", "argv", "target"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string"}
        },
        "target": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "next_seq": {"type": "integer", "minimum": 1},
    "shell_readiness": {
      "enum": ["unverified", "status_verified"]
    },
    "harness_readiness": {
      "enum": ["unverified", "operator_verified"]
    },
    "harness_readiness_evidence": {
      "const": "operator_observed_ready_input"
    },
    "harness_readiness_operator": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._@:-]{1,128}$"
    },
    "harness_readiness_verified_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["repo", "worktree"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "proof_root": {"type": "string", "minLength": 1},
    "caller_text_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "caller_text_files_removed": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "remote_task_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/remoteTaskFile"}
    },
    "preserved_reason": {
      "enum": [
        "checkpoint_failed",
        "human_gate",
        "milestone_complete",
        "operator_stop",
        "route_superseded"
      ]
    },
    "preserved_at": {"type": "string", "format": "date-time"},
    "cleanup_state": {"const": "closed"},
    "cleanup_verified_at": {"type": "string", "format": "date-time"},
    "cleanup_reconciled_absence": {"type": "boolean"}
  },
  "dependentRequired": {
    "harness_readiness_evidence": [
      "harness_readiness_operator",
      "harness_readiness_verified_at"
    ],
    "harness_readiness_operator": [
      "harness_readiness_evidence",
      "harness_readiness_verified_at"
    ],
    "harness_readiness_verified_at": [
      "harness_readiness_evidence",
      "harness_readiness_operator"
    ],
    "cleanup_state": [
      "cleanup_verified_at",
      "cleanup_reconciled_absence"
    ],
    "cleanup_verified_at": [
      "cleanup_state",
      "cleanup_reconciled_absence"
    ],
    "cleanup_reconciled_absence": [
      "cleanup_state",
      "cleanup_verified_at"
    ]
  },
  "$defs": {
    "remoteTaskFile": {
      "type": "object",
      "required": ["path", "ssh_target", "state", "registered_at"],
      "properties": {
        "path": {"type": "string", "pattern": "^/[^\\u0000]*$"},
        "ssh_target": {"type": "string", "minLength": 1},
        "state": {"enum": ["registered", "removal_verified"]},
        "registered_at": {"type": "string", "format": "date-time"},
        "removal_verified_at": {"type": "string", "format": "date-time"},
        "removal_evidence": {
          "enum": [
            "operator_verified_remote_absence",
            "source_bound_terminal_artifact"
          ]
        }
      },
      "dependentRequired": {
        "removal_verified_at": ["removal_evidence"],
        "removal_evidence": ["removal_verified_at"]
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "removal_verified"}}
          },
          "then": {
            "required": ["removal_verified_at", "removal_evidence"]
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "registered"}}
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["removal_verified_at"]},
                {"required": ["removal_evidence"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["name", "version", "protocol", "socket", "incarnation_proven"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "protocol": {"type": "integer", "minimum": 1},
        "socket": {"type": "string", "minLength": 1},
        "incarnation_proven": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "harness_readiness": {"const": "operator_verified"}
        }
      },
      "then": {
        "required": [
          "harness_readiness_evidence",
          "harness_readiness_operator",
          "harness_readiness_verified_at"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["harness_readiness_evidence"]},
            {"required": ["harness_readiness_operator"]},
            {"required": ["harness_readiness_verified_at"]}
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
