{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saariuslystoned.github.io/SaariusSkills/herdr-puppet/remote-harness-census.schema.json",
  "title": "Herdr-Puppet remote harness census v3",
  "$comment": "This schema is the active structural contract. The runtime validate_remote_census validator is authoritative for dynamic fingerprints, source joins, and other cross-field semantic facts JSON Schema cannot express.",
  "type": "object",
  "required": [
    "schema",
    "harness",
    "host",
    "recorded_at",
    "executable",
    "profile",
    "regular_launch",
    "lifecycle_observation",
    "model_observation",
    "source",
    "raw_output_retained"
  ],
  "properties": {
    "schema": {"const": "herdr-puppet.remote-harness-census.v3"},
    "harness": {"enum": ["agy", "codex", "claude", "cursor", "grok"]},
    "host": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._@:+/-]{1,512}$"
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "executable": {
      "type": "object",
      "required": [
        "command",
        "path",
        "version",
        "sha256",
        "version_sha256",
        "help_sha256",
        "fingerprint"
      ],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version_sha256": {"$ref": "#/$defs/sha256"},
        "help_sha256": {"$ref": "#/$defs/sha256"},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "route",
        "root",
        "isolation",
        "enrollment_state",
        "status_exit",
        "raw_output_retained"
      ],
      "properties": {
        "route": {"const": "dedicated_os_user_profile"},
        "root": {"type": "string", "pattern": "^/"},
        "isolation": {"const": "dedicated_remote_user"},
        "enrollment_state": {"enum": ["enrolled", "interactive_pending"]},
        "status_exit": {"oneOf": [{"const": 0}, {"type": "null"}]},
        "raw_output_retained": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {"enrollment_state": {"const": "enrolled"}},
            "required": ["enrollment_state"]
          },
          "then": {"properties": {"status_exit": {"const": 0}}},
          "else": {"properties": {"status_exit": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "regular_launch": {
      "type": "object",
      "required": [
        "argv",
        "environment",
        "inherit_environment",
        "unrestricted",
        "explicit_model_selector",
        "vector_sha256"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "environment": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "inherit_environment": {"const": false},
        "unrestricted": {"const": true},
        "explicit_model_selector": {"type": "boolean"},
        "vector_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "lifecycle_observation": {"$ref": "#/$defs/lifecycleObservation"},
    "model_observation": {
      "type": "object",
      "required": ["selection", "model", "effort"],
      "properties": {
        "selection": {"enum": ["current_default", "explicit"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["worktree"],
      "properties": {"worktree": {"type": "string", "pattern": "^/"}},
      "additionalProperties": false
    },
    "raw_output_retained": {"const": false}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pathSha256": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "checkpointLifecycle": {
      "type": "object",
      "required": ["schema", "strategy", "raw_input_retained"],
      "properties": {
        "schema": {"const": "herdr-puppet.lifecycle-observation.v1"},
        "strategy": {"const": "strict_checkpoint_only"},
        "raw_input_retained": {"const": false}
      },
      "additionalProperties": false
    },
    "claudeLifecycle": {
      "type": "object",
      "required": [
        "schema",
        "strategy",
        "run_id",
        "probe_id",
        "marker_root",
        "interpreter",
        "helper",
        "implementation",
        "event_limits",
        "settings_sha256",
        "stdin_policy",
        "stdout_policy",
        "raw_input_retained"
      ],
      "properties": {
        "schema": {"const": "herdr-puppet.lifecycle-observation.v1"},
        "strategy": {"const": "claude_native_hook_markers"},
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "probe_id": {"$ref": "#/$defs/sha256"},
        "marker_root": {
          "type": "string",
          "pattern": "^/[^\\u0000\\r\\n]+$"
        },
        "interpreter": {
          "type": "object",
          "required": ["path", "sha256", "argv"],
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "argv": {
              "type": "array",
              "prefixItems": [
                {"type": "string", "pattern": "^/"},
                {"const": "-I"},
                {"const": "-c"}
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          },
          "additionalProperties": false
        },
        "helper": {"$ref": "#/$defs/pathSha256"},
        "implementation": {"$ref": "#/$defs/pathSha256"},
        "event_limits": {
          "const": {
            "session_start": 1,
            "user_prompt_submit": 2,
            "stop": 2,
            "stop_failure": 2
          }
        },
        "settings_sha256": {"$ref": "#/$defs/sha256"},
        "stdin_policy": {
          "const": "user_prompt_hashed_in_memory_other_events_unread"
        },
        "stdout_policy": {"const": "empty"},
        "raw_input_retained": {"const": false}
      },
      "additionalProperties": false
    },
    "lifecycleObservation": {
      "oneOf": [
        {"$ref": "#/$defs/checkpointLifecycle"},
        {"$ref": "#/$defs/claudeLifecycle"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"harness": {"const": "agy"}},
        "required": ["harness"]
      },
      "then": {
        "properties": {
          "model_observation": {
            "const": {
              "selection": "explicit",
              "model": "gemini-3.7-flash-high",
              "effort": "high"
            }
          },
          "regular_launch": {
            "properties": {
              "explicit_model_selector": {"const": true},
              "argv": {
                "type": "array",
                "prefixItems": [
                  {"type": "string", "pattern": "^/"},
                  {"const": "--model"},
                  {"const": "gemini-3.7-flash-high"},
                  {"const": "--dangerously-skip-permissions"},
                  {"const": "--sandbox=false"},
                  {"const": "--new-project"},
                  {"const": "--log-file"},
                  {"const": "/dev/null"}
                ],
                "items": false,
                "minItems": 8,
                "maxItems": 8
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "model_observation": {
            "properties": {"selection": {"const": "current_default"}}
          },
          "regular_launch": {
            "properties": {"explicit_model_selector": {"const": false}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"harness": {"const": "claude"}},
        "required": ["harness"]
      },
      "then": {
        "properties": {
          "lifecycle_observation": {"$ref": "#/$defs/claudeLifecycle"}
        }
      },
      "else": {
        "properties": {
          "lifecycle_observation": {"$ref": "#/$defs/checkpointLifecycle"}
        }
      }
    },
    {
      "if": {
        "properties": {"harness": {"const": "cursor"}},
        "required": ["harness"]
      },
      "else": {
        "properties": {
          "profile": {
            "properties": {
              "enrollment_state": {"const": "enrolled"},
              "status_exit": {"const": 0}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
