#!/usr/bin/env python3
"""Read-only structural checks on explicitly selected skill directories.

Not a usefulness, usage, loaded-inventory or retirement assessment.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from collections import defaultdict
from pathlib import Path
from typing import Any


NAME_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
REFERENCE_RE = re.compile(r"(?:^|[(`\s])references/[A-Za-z0-9._/-]+")
def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    selection = parser.add_mutually_exclusive_group(required=True)
    selection.add_argument("--root", type=Path, help="Explicit shelf; inspect immediate directories only.")
    selection.add_argument("--skill", type=Path, action="append", help="Explicit skill directory; repeat to compare skills.")
    parser.add_argument("--json", action="store_true", help="Emit JSON instead of text.")
    parser.add_argument("--max-description", type=int, default=300, help="Advisory character threshold, not a token budget.")
    parser.add_argument("--max-body-words", type=int, default=900, help="Advisory word threshold.")
    parser.add_argument("--min-body-words", type=int, default=80, help="Advisory word threshold.")
    args = parser.parse_args()
    if min(args.max_description, args.max_body_words, args.min_body_words) < 0:
        parser.error("thresholds must be nonnegative")
    if args.min_body_words > args.max_body_words:
        parser.error("minimum body threshold exceeds maximum")
    return args


def read_frontmatter(path: Path) -> tuple[dict[str, str], str, bool]:
    """Parse only flat unquoted/single/double-quoted scalars; defer richer YAML."""
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    if not lines or lines[0] != "---":
        return {}, text, False
    try:
        end = lines.index("---", 1)
    except ValueError:
        return {}, text, False
    data: dict[str, str] = {}
    seen: set[str] = set()
    supported = True
    for line in lines[1:end]:
        if not line.strip() or line.startswith("#"):
            continue
        if line[0].isspace() or ":" not in line:
            supported = False
            continue
        key, value = line.split(":", 1)
        key, value = key.strip(), value.strip()
        if key in seen:
            supported = False
        seen.add(key)
        # Leave YAML comments, escapes, blocks, collections and aliases to a
        # repository validator. Never diagnose their apparent values as invalid.
        if not value or value[0] in "|>!&*[{" or " #" in value or "\\" in value:
            supported = False
            continue
        if value[0] in "\"'":
            quote = value[0]
            if len(value) < 2 or value[-1] != quote or quote in value[1:-1]:
                supported = False
                continue
            value = value[1:-1]
        data[key] = value
    return data, "\n".join(lines[end + 1:]).strip(), supported


def safe_file(skill_dir: Path, relative: str) -> bool:
    """Do not follow symlinks, including links that point back inside scope."""
    target = skill_dir / relative
    if not target.is_relative_to(skill_dir) or ".." in Path(relative).parts:
        return False
    return not any((skill_dir / Path(*Path(relative).parts[:i])).is_symlink()
                   for i in range(1, len(Path(relative).parts) + 1))


def referenced_paths(body: str) -> list[str]:
    # Deliberately bounded: references/ tokens in SKILL.md only. Rich link
    # forms, anchors, scripts and transitive references require native checks.
    return sorted({match.group(0).strip("(` \n\t").rstrip(".") for match in REFERENCE_RE.finditer(body)})


def audit_skill(skill_dir: Path, args: argparse.Namespace) -> dict[str, Any]:
    result: dict[str, Any] = {
        "directory": skill_dir.name, "path": str(skill_dir), "name": skill_dir.name,
        "issues": [], "references": [], "packaging_errors": [], "advisories": [], "unverified": [],
        "metadata_verified": False,
    }
    errors, advisories, unverified = result["packaging_errors"], result["advisories"], result["unverified"]
    skill_file = skill_dir / "SKILL.md"
    if not safe_file(skill_dir, "SKILL.md"):
        unverified.append("symlink-skill-md")
    elif not skill_file.is_file():
        errors.append("missing-skill-md")
    else:
        try:
            frontmatter, body, supported = read_frontmatter(skill_file)
            name, description = frontmatter.get("name", ""), frontmatter.get("description", "")
            result.update(body_words=len(body.split()), references=referenced_paths(body))
            if supported:
                result.update(name=name, description_length=len(description), metadata_verified=True)
                if name != skill_dir.name:
                    errors.append("name-mismatch")
                if not NAME_RE.fullmatch(name):
                    errors.append("invalid-name")
                if not description:
                    errors.append("missing-description")
                if len(description) > args.max_description:
                    advisories.append("description-pressure")
            elif not frontmatter and not body.startswith("---"):
                errors.append("missing-frontmatter")
            else:
                unverified.append("frontmatter-needs-validator")
            if result["body_words"] < args.min_body_words:
                advisories.append("body-too-thin")
            if result["body_words"] > args.max_body_words:
                advisories.append("body-pressure")
            agent_path = "agents/openai.yaml"
            if not safe_file(skill_dir, agent_path):
                unverified.append("symlink-openai-yaml")
            elif not (skill_dir / agent_path).is_file():
                advisories.append("missing-openai-yaml")
            elif supported and f"${name}" not in (skill_dir / agent_path).read_text(encoding="utf-8"):
                advisories.append("openai-yaml-missing-skill-prompt")
            missing_refs = []
            for ref in result["references"]:
                if not safe_file(skill_dir, ref):
                    unverified.append("reference-outside-scope-or-symlink")
                elif not (skill_dir / ref).is_file():
                    missing_refs.append(ref)
            if missing_refs:
                errors.append("missing-reference")
                result["missing_references"] = missing_refs
        except (OSError, UnicodeError):
            unverified.append("unreadable-skill-input")
    result["issues"] = errors + advisories + sorted(set(unverified))
    return result


def audit_selection(args: argparse.Namespace) -> dict[str, Any]:
    root = args.root.expanduser().absolute() if args.root else None
    selected = [root] if root else [path.expanduser().absolute() for path in args.skill]
    for path in selected:
        if path.is_symlink() or not path.is_dir():
            raise ValueError(f"selection must be an existing non-symlink directory: {path}")
    selected = [path.resolve() for path in selected]
    root = selected[0] if root else None
    skipped = []
    if root:
        dirs = []
        for child in sorted(root.iterdir()):
            if child.is_symlink():
                skipped.append(str(child))
            elif child.is_dir():
                dirs.append(child)
    else:
        dirs = sorted(set(selected))
    skills = [audit_skill(path, args) for path in dirs]
    by_name: dict[str, list[str]] = defaultdict(list)
    for skill in skills:
        # Unknown metadata must not produce fabricated duplicate names.
        if skill["metadata_verified"] and "invalid-name" not in skill["issues"]:
            by_name[skill["name"]].append(skill["directory"] if root else skill["path"])
    issue_counts: dict[str, int] = defaultdict(int)
    for skill in skills:
        for issue in skill["issues"]:
            issue_counts[issue] += 1
    return {
        "root": str(root) if root else None,
        "selection": [str(path) for path in selected],
        "skill_count": len(skills), "skills": skills,
        "duplicate_names": {name: dirs for name, dirs in by_name.items() if len(dirs) > 1},
        "issue_counts": dict(sorted(issue_counts.items())), "skipped_symlinks": skipped,
        "qualitative_assessment": "not-performed",
        "privacy_note": "Only selected skill metadata and optional UI metadata were read; no logs or transcripts were scanned.",
    }


def print_text(report: dict[str, Any]) -> None:
    print(f"selection: {', '.join(report['selection'])}")
    print(f"skills: {report['skill_count']}; qualitative assessment: not performed")
    print(f"privacy: {report['privacy_note']}")
    for name, dirs in report["duplicate_names"].items():
        print(f"duplicate candidate {name}: {', '.join(dirs)}")
    for path in report["skipped_symlinks"]:
        print(f"skipped symlink: {path}")
    for skill in report["skills"]:
        print(f"{skill['path']}:")
        for category in ("packaging_errors", "advisories", "unverified"):
            print(f"  {category}: {', '.join(skill[category]) or 'none'}")


def main() -> int:
    args = parse_args()
    try:
        report = audit_selection(args)
    except (OSError, ValueError) as exc:
        print(f"audit-skills: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_text(report)
    # Findings are report data, not a validity/retirement verdict. Only invalid
    # selection or inability to enumerate the shelf makes this command fail.
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
