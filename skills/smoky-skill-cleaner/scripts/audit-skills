#!/usr/bin/env python3
"""Read-only skill shelf audit."""

from __future__ import annotations

import argparse
import json
import re
from collections import defaultdict
from pathlib import Path
from typing import Any


NAME_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
REFERENCE_RE = re.compile(r"(?:^|[(`\s])references/[A-Za-z0-9._/-]+")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Audit a skill root without scanning logs.")
    parser.add_argument("--root", type=Path, default=Path("skills"), help="Skill root to audit.")
    parser.add_argument("--json", action="store_true", help="Emit JSON instead of text.")
    parser.add_argument("--max-description", type=int, default=300)
    parser.add_argument("--max-body-words", type=int, default=900)
    parser.add_argument("--min-body-words", type=int, default=80)
    return parser.parse_args()


def read_frontmatter(path: Path) -> tuple[dict[str, str], str]:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end == -1:
        return {}, text
    raw = text[4:end].strip().splitlines()
    body = text[end + 4 :].strip()
    data: dict[str, str] = {}
    for line in raw:
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        data[key.strip()] = value.strip().strip('"')
    return data, body


def referenced_paths(skill_dir: Path, body: str) -> list[str]:
    paths: list[str] = []
    for match in REFERENCE_RE.finditer(body):
        token = match.group(0).strip("(` \n\t")
        if token.startswith("references/"):
            paths.append(token)
    return sorted(set(paths))


def audit_skill(skill_dir: Path, args: argparse.Namespace) -> dict[str, Any]:
    skill_file = skill_dir / "SKILL.md"
    result: dict[str, Any] = {
        "directory": skill_dir.name,
        "name": skill_dir.name,
        "issues": [],
        "references": [],
    }
    if not skill_file.is_file():
        result["issues"].append("missing-skill-md")
        return result

    frontmatter, body = read_frontmatter(skill_file)
    name = frontmatter.get("name", "")
    description = frontmatter.get("description", "")
    body_words = len(body.split())
    refs = referenced_paths(skill_dir, body)
    agent_file = skill_dir / "agents" / "openai.yaml"

    result.update(
        {
            "name": name,
            "description_length": len(description),
            "body_words": body_words,
            "references": refs,
        }
    )

    if name != skill_dir.name:
        result["issues"].append("name-mismatch")
    if not NAME_RE.match(name):
        result["issues"].append("invalid-name")
    if not description:
        result["issues"].append("missing-description")
    if len(description) > args.max_description:
        result["issues"].append("description-pressure")
    if body_words < args.min_body_words:
        result["issues"].append("body-too-thin")
    if body_words > args.max_body_words:
        result["issues"].append("body-pressure")
    if not agent_file.is_file():
        result["issues"].append("missing-openai-yaml")
    else:
        agent_text = agent_file.read_text(encoding="utf-8")
        if f"${name}" not in agent_text:
            result["issues"].append("openai-yaml-missing-skill-prompt")

    missing_refs = [ref for ref in refs if not (skill_dir / ref).exists()]
    if missing_refs:
        result["issues"].append("missing-reference")
        result["missing_references"] = missing_refs

    return result


def audit_root(root: Path, args: argparse.Namespace) -> dict[str, Any]:
    root = root.expanduser().resolve()
    skills = []
    if root.is_dir():
        for child in sorted(path for path in root.iterdir() if path.is_dir()):
            skills.append(audit_skill(child, args))

    by_name: dict[str, list[str]] = defaultdict(list)
    for skill in skills:
        name = str(skill.get("name") or skill["directory"])
        by_name[name].append(skill["directory"])

    duplicate_names = {name: dirs for name, dirs in by_name.items() if len(dirs) > 1}
    issue_counts: dict[str, int] = defaultdict(int)
    for skill in skills:
        for issue in skill.get("issues", []):
            issue_counts[issue] += 1

    return {
        "root": str(root),
        "skill_count": len(skills),
        "skills": skills,
        "duplicate_names": duplicate_names,
        "issue_counts": dict(sorted(issue_counts.items())),
        "privacy_note": "No logs, shell history, auth stores, or session transcripts were scanned.",
    }


def print_text(report: dict[str, Any]) -> None:
    print(f"root: {report['root']}")
    print(f"skills: {report['skill_count']}")
    print(f"privacy: {report['privacy_note']}")
    if report["duplicate_names"]:
        print("duplicate names:")
        for name, dirs in report["duplicate_names"].items():
            print(f"  - {name}: {', '.join(dirs)}")
    if report["issue_counts"]:
        print("issue counts:")
        for issue, count in report["issue_counts"].items():
            print(f"  - {issue}: {count}")
    print("skills:")
    for skill in report["skills"]:
        issues = ",".join(skill.get("issues", [])) or "ok"
        print(
            f"  - {skill['directory']}: body_words={skill.get('body_words', 0)} "
            f"description_chars={skill.get('description_length', 0)} issues={issues}"
        )


def main() -> int:
    args = parse_args()
    report = audit_root(args.root, args)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_text(report)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
