/* Derive all physical degrees of freedom purely from normalized timeline t (0..1) */
function deriveKinematics(t){
  const u = clamp01(t);
  return {
    t: u,
    // Step 1: Lid hinges open 0 -> 110 deg; marketing traffic & coupon stamp press (-20%)
    lidOpen: easeInOutCubic(subRange(u, 0.01, 0.14)),
    screenOn: easeInOutCubic(subRange(u, 0.06, 0.16)),
    couponStamp: Math.sin(subRange(u, 0.08, 0.19) * Math.PI),
    couponApplied: easeInOutCubic(subRange(u, 0.11, 0.17)),
    // Step 2: Cloudflare Edge rotor & Stripe Vault payment gate + ledger cylinders
    edgeSpin: u > 0.04 ? u * 12 : 0,
    stripeGate: easeInOutCubic(subRange(u, 0.21, 0.34)),
    stripePaid: u >= 0.28 ? 1 : easeInOutCubic(subRange(u, 0.21, 0.28)),
    // Step 3: D1 Inventory Rack SKU slide + Email Pneumatic capsule + Product lift & drop into open box
    skuPick: easeInOutCubic(subRange(u, 0.40, 0.52)),
    emailPulse: subRange(u, 0.41, 0.56),
    emailSent: u >= 0.50 ? 1 : 0,
    packProgress: easeInOutCubic(subRange(u, 0.40, 0.56)),
    // Step 4: 4 box flaps fold 0 -> 90 deg, kraft tape strip seals seam, thermal label prints & slaps onto box
    flapFold: easeInOutCubic(subRange(u, 0.58, 0.66)),
    tapeSeal: easeInOutCubic(subRange(u, 0.65, 0.71)),
    printHeat: Math.sin(subRange(u, 0.66, 0.78) * Math.PI),
    labelFlight: easeInOutCubic(subRange(u, 0.68, 0.77)),
    // Step 5: Packed, taped, labeled box launches into outgoing mail chute + multiplane delivery van
    mailLaunch: easeInOutCubic(subRange(u, 0.81, 0.95)),
    chuteFlap: Math.sin(subRange(u, 0.85, 0.96) * Math.PI),
    vanTransit: easeInOutCubic(subRange(u, 0.78, 0.98)),
  };
}

const boxOfPts = (pts, pad = 0.4) => [
  [0,1,2].map(i => Math.min(...pts.map(p => p[i])) - pad),
  [0,1,2].map(i => Math.max(...pts.map(p => p[i])) + pad),
];

function wireSegs(pts, col, w = 0.45){
  const out = [];
  for (let i = 0; i < pts.length - 1; i++){
    const a = pts[i], b = pts[i + 1], seg = [a, b], d = pd(seg, false);
    const svg = `<path d="${d}" fill="none" stroke="${INK}" stroke-width="${f(2*w + 0.9)}" stroke-linecap="round"/>`
      + `<path d="${d}" fill="none" stroke="${col}" stroke-width="${f(2*w)}" stroke-linecap="round"/>`;
    out.push({ box: boxOfPts(seg, 0.3), svg });
  }
  return out;
}

