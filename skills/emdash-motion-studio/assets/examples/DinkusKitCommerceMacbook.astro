}

function drawThermalPrinter(st, K){
  const x0 = 20, x1 = 52, y0 = 54, y1 = 84, z0 = BH, z1 = BH + 20;
  const prof = rrUV(y0, z0, y1, z1, 4.0, 6);
  const FRONT = facing([1, 0, 0]), TOP = facing([0, 0, 1]), BACK = facing([-1, 0, 0]);
  let body = extrude(prof, x0, x1, CERAMIC, tone);

  if (FRONT){
    body += shape(on(PX(x1), prof), tone([1, 0, 0], CERAMIC), 1.0);
    // Front dark slate face plate & 4x6 label exit mouth slot
    body += shape(on(PX(x1 + 0.05), rrUV(y0 + 3, z0 + 4, y1 - 3, z1 - 3, 2)), AIZOME.d, 0.8);
    body += shape(on(PX(x1 + 0.1), rectUV(58, BH + 10.2, 80, BH + 12.2)), '#12161f', 0.7);
    // Status LED (green when ready, glowing orange when printing)
    const ledCol = K.printHeat > 0.05 ? '#f79640' : '#2ea874';
    body += shape(on(PX(x1 + 0.12), ellUV(60, BH + 15.2, 1.3, 1.3, 10)), ledCol, 0.5);
    body += tx(x1 + 0.18, 69, BH + 6.5, 'PITNEY BOWES 4x6', 2.4, '#f4f1ea', 800);
  }
  if (BACK){
    body += shape(on(PX(x0), prof), tone([-1, 0, 0], CERAMIC), 1.0);
    body += shape(on(PX(x0 - 0.05), rrUV(60, z0 + 4, 78, z0 + 12, 1.2)), SPACE.m, 0.7);
  }
  if (TOP){
    // Translucent top inspection window on clamshell lid
    const win = on(PZ(z1 + 0.05), rrUV(x0 + 6, y0 + 6, x1 - 8, y1 - 6, 2));
    body += shape(win, CLEAR.m, 0.8);
  }
  body += hullInk([...on(PX(x0), prof), ...on(PX(x1), prof)], 2.4);

  const k = ease(st.xr || 0);
  if (k > 0){
    body = xrGhost(body, '', k, prof, x0, x1, CERAMIC);
  }
  return {
    box: [[x0, y0, z0], [x1 + 0.5, y1, z1 + 0.5]],
    svg: act('printer', body),
  };
}

/* ---------- 3. ORDERED DINKUSKIT PRODUCT & CORRUGATED SHIPPING BOX (openShell + 4 Flaps + Tape + 4×6 Label) ---------- */
function drawProductSvg(cx, cy, zBot){
  // Aizome Indigo Artisan Boxed Kettle / Ceramic Vessel (width 11, depth 11, height 10)
  const h = 9.5, r = 4.6;
  let s = '';
  // Indigo presentation box base + brass band + ceramic lid knob
  s += box(cx - 5.2, cy - 5.2, zBot, cx + 5.2, cy + 5.2, zBot + h, AIZOME, tone, 0.95);
  s += box(cx - 5.3, cy - 5.3, zBot + h * 0.42, cx + 5.3, cy + 5.3, zBot + h * 0.62, BRASS, toneI, 0.7);
  s += cyl(cx, cy, zBot + h, zBot + h + 1.8, r * 0.45, BRASS, toneI, 0.8, 14);
  if (facing([0, 0, 1])){
    s += fill(pd(on(PZ(zBot + h + 0.05), rectUV(cx - 3.5, cy - 3.5, cx + 3.5, cy + 3.5))), '#f4f1ea');
  }
  return s;
}

function drawShippingBoxAndProduct(K){
  const parts = [];
  // Box base position on packing station (x = 60..88, y = 36..62, z = BH..BH+18)
  // In Step 5 (mailLaunch = 0..1), the sealed & labeled box slides across the desk into the Mail Chute at y = 12..32!
  const slideY = -K.mailLaunch * 25.0;
  const dropZ  = K.mailLaunch > 0.65 ? -((K.mailLaunch - 0.65) / 0.35) * 2.2 : 0;

  const bx0 = 60, bx1 = 88;
  const by0 = 36 + slideY, by1 = 62 + slideY;
  const bz0 = BH + Math.max(0, dropZ), bz1 = bz0 + 18;
  const bCx = (bx0 + bx1) / 2, bCy = (by0 + by1) / 2;

  // Staging pad where product waits before Step 3 (x = 65..83, y = 66..82, z = BH..BH+1.2)
  parts.push({
    box: [[65, 66, BH], [83, 82, BH + 1.3]],
    svg: box(65, 66, BH, 83, 82, BH + 1.2, SPACE, toneI, 0.8),
  });

  // Product trajectory in Step 3 (packProgress = 0..1):
  // From staging pad (x=74, y=74, z=BH+1.2) -> parabolic arc over box rim (z_peak = BH+25) -> nested inside box (x=74, y=49, z=BH+1.0)
  const pk = K.packProgress;
  const prodY = lerp(74, bCy, pk);
  const prodZ = lerp(BH + 1.2, bz0 + 1.0, pk) + Math.sin(pk * Math.PI) * 18.5;

  // If product has not yet crossed over the box rim (pk < 0.62), draw it as its own depth-sorted part above/beside the box;
  // Once it drops into the open box (pk >= 0.62), render it as `contents` inside `openShell` so the open cardboard walls wrap around it!
  const nestedInBox = pk >= 0.62;
  if (!nestedInBox){
    parts.push({
      box: [[bCx - 5.5, prodY - 5.5, prodZ], [bCx + 5.5, prodY + 5.5, prodZ + 11.5]],
      svg: act('box', drawProductSvg(bCx, prodY, prodZ)),
    });
  }

  // Open-top corrugated cardboard shipping box using core.js openShell(A, B, colour, contents)
  const A = on(PZ(bz0), rectUV(bx0, by0, bx1, by1));
  const B = on(PZ(bz1), rectUV(bx0, by0, bx1, by1));
  const floorSvg = fill(pd(A), KRAFT.d);
  const innerContents = floorSvg + (nestedInBox && K.flapFold < 0.95 ? drawProductSvg(bCx, bCy, prodZ) : '');
  let boxSvg = openShell(A, B, nr => tone(nr, KRAFT), innerContents);
  boxSvg += hullInk([...A, ...B], 2.0);

  // 4 Hinged Top Cardboard Flaps along the rim z = bz1:
  // flapFold = 0 (open outward/upward at 20 deg) -> flapFold = 1 (folded flat closed at 90 deg horizontal over the box mouth!)
  const fk = K.flapFold;
  const halfX = (bx1 - bx0) / 2; // 14
  const halfY = (by1 - by0) / 2; // 13
  // Side flaps (Left y=by1 and Right y=by0) fold inward first; Front (x=bx1) and Back (x=bx0) flaps fold cleanly on top
  const angSide = (-25 + fk * 115) * Math.PI / 180; // -25 deg (open) -> +90 deg (flat horizontal)
  const angFB   = (-20 + fk * 110) * Math.PI / 180;

  const sInY = Math.sin(angSide) * (halfY - 0.4), sUpY = Math.cos(angSide) * (halfY - 0.4) * (1 - fk * 0.98);
  const sInX = Math.sin(angFB) * (halfX - 0.2),   sUpX = Math.cos(angFB) * (halfX - 0.2) * (1 - fk * 0.98);

  // Left flap (hinged at y = by1, folds toward -y)
  const flapL = [
    [bx0 + 0.4, by1, bz1],
    [bx1 - 0.4, by1, bz1],
    [bx1 - 0.4, by1 - Math.max(-3, sInY), bz1 + sUpY],
    [bx0 + 0.4, by1 - Math.max(-3, sInY), bz1 + sUpY],
  ];
  // Right flap (hinged at y = by0, folds toward +y)
  const flapR = [
    [bx0 + 0.4, by0, bz1],
    [bx1 - 0.4, by0, bz1],
    [bx1 - 0.4, by0 + Math.max(-3, sInY), bz1 + sUpY],
    [bx0 + 0.4, by0 + Math.max(-3, sInY), bz1 + sUpY],
  ];
  // Back flap (hinged at x = bx0, folds toward +x)
  const flapB = [
    [bx0, by0, bz1 + 0.15],
    [bx0, by1, bz1 + 0.15],
    [bx0 + Math.max(-3, sInX), by1, bz1 + 0.15 + sUpX],
    [bx0 + Math.max(-3, sInX), by0, bz1 + 0.15 + sUpX],
  ];
  // Front flap (hinged at x = bx1, folds toward -x)
  const flapF = [
    [bx1, by0, bz1 + 0.15],
    [bx1, by1, bz1 + 0.15],
    [bx1 - Math.max(-3, sInX), by1, bz1 + 0.15 + sUpX],
    [bx1 - Math.max(-3, sInX), by0, bz1 + 0.15 + sUpX],
  ];

  if (fk < 0.85){
    boxSvg += shape(flapL, KRAFT.m, 0.85) + shape(flapR, KRAFT.m, 0.85);
  }
  boxSvg += shape(flapB, KRAFT.l, 0.95) + shape(flapF, KRAFT.l, 0.95);
  if (fk >= 0.85){
    // Center seam line between front and back flaps
    boxSvg += line([[bCx, by0, bz1 + 0.2], [bCx, by1, bz1 + 0.2]], 1.0);
  }

  // Step 4b: Kraft Packing Tape strip sweeping across top seam (tapeSeal = 0..1)
  if (K.tapeSeal > 0.02){
    const tk = K.tapeSeal;
    const ty0 = by0 + 10.0, ty1 = by1 - 10.0;
    const txEnd = bx0 + (bx1 - bx0) * tk;
    const topTape = on(PZ(bz1 + 0.28), rectUV(bx0, ty0, txEnd, ty1));
    boxSvg += shape(topTape, TAPE_M.l, 0.75);
    // Front lip overhang once tape reaches front edge
    if (tk > 0.85 && facing([1, 0, 0])){
      const lipH = ((tk - 0.85) / 0.15) * 4.5;
      boxSvg += shape(on(PX(bx1 + 0.08), rectUV(ty0, bz1 - lipH, ty1, bz1 + 0.25)), TAPE_M.m, 0.65);
    }
  }

  // Front fragile / DinkusKit stencil on box front wall
  if (facing([1, 0, 0])){
    boxSvg += tx(bx1 + 0.12, bCy, bz0 + 8.5, 'DINKUSKIT', 2.8, INK, 800);
    boxSvg += tx(bx1 + 0.12, bCy, bz0 + 5.0, 'ORD #1042', 2.2, KRAFT.d, 700);
  }

  parts.push({
    box: [[bx0 - 3, by0 - 3, bz0], [bx1 + 3, by1 + 3, bz1 + 10]],
    svg: act('box', boxSvg),
  });

  // Step 4c: Pitney Bowes 4x6 Thermal Shipping Label ejecting from printer & slapping onto the sealed box!
  if (K.labelFlight > 0.01){
    const lk = K.labelFlight;
    // Start at printer exit slot (x=53, y=69, z=BH+11.2); land flat on sealed box top (x=76, y=bCy, z=bz1+0.42)
    const lx = lerp(54, bCx + 3.5, lk);
    const ly = lerp(69, bCy, lk);
    const lz = lerp(BH + 11.2, bz1 + 0.42, lk) + Math.sin(lk * Math.PI) * 9.5;
    const lw = 9.0, ld = 13.0; // 4x6 proportion
    const lblPts = on(PZ(lz), rectUV(lx - lw/2, ly - ld/2, lx + lw/2, ly + ld/2));
    let lblSvg = shape(lblPts, '#ffffff', 0.95);
    // Red Pitney Bowes postage header strip
    lblSvg += fill(pd(on(PZ(lz + 0.04), rectUV(lx + lw/2 - 2.2, ly - ld/2 + 0.8, lx + lw/2 - 0.7, ly + ld/2 - 0.8))), CRIM.l);
    // Bold 'P' priority icon box
    lblSvg += shape(on(PZ(lz + 0.04), rectUV(lx + 0.2, ly + 1.5, lx + 2.4, ly + 5.2)), '#ffffff', 0.5);
    // Barcode stripes across lower half of 4x6 label
    for (let i = 0; i < 7; i++){
      const by = ly - ld/2 + 1.4 + i * 1.45;
      lblSvg += line([[lx - lw/2 + 1.2, by, lz + 0.06], [lx - 0.4, by, lz + 0.06]], i % 2 === 0 ? 1.1 : 0.65);
    }
    parts.push({
      box: [[lx - lw/2 - 0.5, ly - ld/2 - 0.5, lz - 0.2], [lx + lw/2 + 0.5, ly + ld/2 + 0.5, lz + 1.5]],
      svg: act('box', lblSvg),
    });
  }

  return parts;
}

/* ---------- 4. OUTGOING MAIL CHUTE / DISPATCH HOPPER (Right Side of Desk) ---------- */
function drawMailChute(K){
  const x0 = 56, x1 = 92, y0 = 4, y1 = 22, z0 = BH, z1 = BH + 28;
  // Main dispatch tower housing
  let s = box(x0, y0, z0, x1, y1, z1, AIZOME, tone, 1.1);
  // Brass intake frame on the +y face (y = y1 = 22, facing the shipping box)
  if (facing([0, 1, 0])){
    s += shape(on(PY(y1 + 0.06), rrUV(x0 + 2.5, z0 + 2.0, x1 - 2.5, z1 - 4.0, 2.0)), BRASS.l, 0.9);
    // Dark recessed mail drop cavity
    s += shape(on(PY(y1 + 0.12), rectUV(x0 + 4.5, z0 + 3.0, x1 - 4.5, z1 - 7.0)), '#10151f', 0.8);
    // Swinging brass mail chute flap
    const swing = K.chuteFlap * 3.5;
    s += shape([
      [x0 + 4.8, y1 + 0.16, z1 - 4.2],
      [x1 - 4.8, y1 + 0.16, z1 - 4.2],
      [x1 - 4.8, y1 + 0.16 - swing, z1 - 9.5 + swing * 0.4],
      [x0 + 4.8, y1 + 0.16 - swing, z1 - 9.5 + swing * 0.4],
    ], BRASS.m, 0.75);
  }
  if (facing([1, 0, 0])){
    // Front plaque & dispatch status indicator on mail chute
    s += shape(on(PX(x1 + 0.06), rrUV(y0 + 2.5, z1 - 9.5, y1 - 2.5, z1 - 2.5, 1.2)), '#f4f1ea', 0.75);
    s += tx(x1 + 0.14, (y0 + y1)/2, z1 - 5.5, 'MAIL CHUTE', 2.4, INK, 800);
    const doneCol = K.mailLaunch > 0.8 ? '#2ea874' : '#d5cec0';
    s += shape(on(PX(x1 + 0.08), ellUV((y0 + y1)/2, z0 + 11, 2.2, 2.2, 14)), doneCol, 0.7);
  }
  // Angled dispatch roof cap
  const roofA = on(PZ(z1), rectUV(x0, y0, x1, y1));
  const roofB = on(PZ(z1 + 3.5), rectUV(x0 + 3, y0 + 2, x1 - 3, y1 - 2));
  s += loft(roofA, roofB, nr => tone(nr, BRASS)) + fill(pd(roofB), BRASS.l) + hullInk([...roofA, ...roofB], 1.6);
  s += hullInk([...on(PZ(z0), rectUV(x0, y0, x1, y1)), ...roofB], 2.2);

  return {
    box: [[x0, y0, z0], [x1 + 0.5, y1 + 0.5, z1 + 4]],
    svg: act('chute', s),
  };
}

/* ---------- MAIN SCENE COMPOSITOR ---------- */
function scene(st, m){
  const K = deriveKinematics(st.t || 0);
  const k = ease(st.xr || 0);

  // 1. Mode B Multiplane Horizon + Pigment Drift Backdrop at top of stage
  let s = renderMultiplaneBackdrop(st, K);

  // 2. Studio Desk Board + Cast Shadows
  s += board(0, 0, BW, BD, BH, 6, BOARD);

  const shadowcasterPts = [
    ...on(PZ(BH), rectUV(24, 94, 72, 152)),
    ...on(PZ(BH + 10), rectUV(24, 94, 72, 152)),
    ...on(PZ(BH), rectUV(20, 54, 52, 84)),
    ...on(PZ(BH + 20), rectUV(20, 54, 52, 84)),
    ...on(PZ(BH), rectUV(56, 4, 92, 22)),
    ...on(PZ(BH + 28), rectUV(56, 4, 92, 22)),
  ];
  s += clipTo(BTOP, castShadow(shadowcasterPts, BH));

  // 3. Depth-sorted 3D Desk Assemblies (MacBook Base, Hinged Lid, USB-C Cable, Thermal Printer, Box+Product, Mail Chute)
  const deskParts = [
    {
      box: [[24, 94, BH], [72, 152, BH + 6.6]],
      svg: drawMacbookBase(st, K, m),
    },
    drawMacbookLid(st, K, m),
    drawUsbCable(K),
    drawThermalPrinter(st, K),
    ...drawShippingBoxAndProduct(K),
    drawMailChute(K),
  ];
  s += byDepth(deskParts);

  // 4. Live Callout Labels (See-through Mode vs Surface Mode)
  const bounds = [0, BW, 0, BD, 0, H];
  if (k > 0.6){
    s += xrCallouts([
      { at: [37.5, 137.5, BH + 5.0], text: 'CLOUDFLARE EDGE',     on: K.lidOpen > 0.3 },
      { at: [48.5, 143.5, BH + 5.5], text: 'MARKETING FUNNEL',    on: K.lidOpen > 0.2 && K.t < 0.3 },
      { at: [60.0, 138.0, BH + 6.0], text: 'COUPON STAMP PRESS',  on: K.couponApplied > 0.2 && K.t < 0.35 },
      { at: [34.5, 121.0, BH + 5.2], text: 'STRIPE VAULT',        on: K.stripePaid > 0.3 },
      { at: [61.0, 114.0, BH + 3.8], text: 'D1 INVENTORY RACK',   on: K.skuPick > 0.1 },
      { at: [43.0, 100.5, BH + 3.5], text: 'EMAIL PNEUMATIC TUBE',on: K.emailPulse > 0.05 },
      { at: [44.0, 95.5,  BH + 3.5], text: 'USB-C BUS',           on: K.printHeat > 0.05 || K.labelFlight > 0.05 },
      { at: [43.5, 68.0,  BH + 13.0],text: 'THERMAL PRINT HEAD',  on: K.printHeat > 0.05 },
      { at: [29.0, 68.0,  BH + 11.0],text: 'LABEL ROLL',          on: K.labelFlight > 0.05 },
    ], bounds);
  } else {
    const lidZ = BH + 6.6 + Math.sin(K.lidOpen * 110 * Math.PI / 180) * 32;
    const boxY = 49 - K.mailLaunch * 25;
    s += xrCallouts([
      { at: [48, 123, Math.max(BH + 8, lidZ)], text: K.lidOpen < 0.1 ? 'MACBOOK (CLOSED)' : 'DINKUSKIT STOREFRONT', on: K.screenOn > 0.2 },
      { at: [36, 69,  BH + 20],                text: 'THERMAL PRINTER (4x6)', on: K.printHeat > 0.05 || K.labelFlight > 0.1 },
      { at: [74, boxY, BH + 19],               text: K.tapeSeal > 0.5 ? 'TAPED & LABELED BOX' : 'CORRUGATED BOX', on: K.packProgress > 0.1 },
      { at: [74, 13,  BH + 26],                text: 'OUTGOING MAIL CHUTE',   on: K.mailLaunch > 0.2 },
    ], bounds);
  }

  return s;
}

const xrCaption = st => {
  const K = deriveKinematics(st.t || 0);
  if (K.mailLaunch > 0.3) return 'Step 5 (Completed): The taped and labeled 4×6 parcel launches into the outgoing mail chute while the courier van crosses the multiplane viaduct to the customer.';
  if (K.flapFold > 0.1) return 'Step 4 (Tape & Thermal Label): The 4 corrugated box flaps fold 90°, kraft tape seals the center seam, and the Pitney Bowes thermal print head burns and slaps a 4×6 barcode label onto the box.';
  if (K.packProgress > 0.1) return 'Step 3 (Inventory & Pack): The D1 Inventory Rack slides out a SKU (-1 stock), the Email Pneumatic Tube fires the receipt capsule, and the ordered ceramic kettle drops into the open cardboard box.';
  if (K.stripeGate > 0.1) return 'Step 2 (Stripe Vault): Checkout spins the Cloudflare Edge turbine and swings open the internal Stripe Vault gate, settling $68.00 net into the brass ledger cylinders.';
  if (K.lidOpen > 0.05) return 'Step 1 (Order In): The MacBook lid hinges open to 110°, lighting up the DinkusKit storefront. Customer traffic enters the Marketing Funnel and the Coupon Stamp Press stamps -20% (SAVE20).';
  return 'Closed MacBook Ready State (t = 0): Click a step button or Auto-Play to hinge open the MacBook and watch the internal 38-part Commerce Factory fulfill an order end-to-end.';
};

/* ---------- TIMELINE ANIMATION CONTROLLER ---------- */
let ui, animId = 0;

function syncChoreoBar(st){
  const root = (ui && ui.rootEl) || document;
  const t = clamp01(st.t || 0);
  const slider = root.querySelector('#dk-slider');
  const timeEl = root.querySelector('#dk-time');
  if (slider) slider.value = String(t);
  if (timeEl) timeEl.textContent = `T = ${t.toFixed(2)}`;
  root.querySelectorAll('.dk-cue').forEach(btn => {
    const r0 = +btn.dataset.r0, r1 = +btn.dataset.r1;
    btn.setAttribute('data-active', String(t >= r0 && t <= r1));
    btn.setAttribute('data-passed', String(t > r1));
  });
}

function animateToTime(st, targetT, ms = 900){
  st.autoPlay = false;
  const t0 = st.t || 0, dtTotal = clamp01(targetT) - t0, id = ++animId;
  if (Math.abs(dtTotal) < 1e-4){
    st.t = clamp01(targetT);
    syncChoreoBar(st);
    ui.render();
    return;
  }
  let el = 0;
  ui.animate(dt => {
    if (id !== animId) return false;
    el += dt * 1000;
    const k = Math.min(1, el / ms);
    st.t = clamp01(t0 + dtTotal * easeInOutCubic(k));
    syncChoreoBar(st);
    return k < 1;
  });
}

function toggleAutoPlay(st){
  if (st.autoPlay){
    st.autoPlay = false;
    animId++;
    return;
  }
  if (st.t >= 0.95) st.t = 0;
  st.autoPlay = true;
  const id = ++animId;
  ui.animate(dt => {
    if (!st.autoPlay || id !== animId) return false;
    st.t = clamp01((st.t || 0) + dt / 9.5);
    syncChoreoBar(st);
    if (st.t >= 1){
      st.autoPlay = false;
      return false;
    }
    return true;
  });
}

ui = mountFigure({
  fig: '07',
  turn: 'full',
  title: 'DinkusKit — Commerce Inside the MacBook',
  idea: 'Every DinkusKit order triggers a physical chain reaction: Cloudflare Edge routing, a -20% coupon press, Stripe Vault settlement, D1 SKU picking, email dispatch, box packing & taping, a 4×6 Pitney Bowes thermal label slap, and mail chute dispatch.',
  size: [BW, BD, H],
  center: [BW / 2, BD / 2],
  palette: 'aizome',
  state: { t: 0, autoPlay: false, xr: 0, xrT: 0 },
  scene,
  readout: st => {
    const K = deriveKinematics(st.t || 0);
    if (K.mailLaunch > 0.7) return 'step 5 · parcel in mail chute · order completed';
    if (K.flapFold > 0.1) return 'step 4 · flaps folded · taped · 4x6 label slapped';
    if (K.packProgress > 0.1) return 'step 3 · -1 sku picked · email sent · packed in open box';
    if (K.stripeGate > 0.1) return 'step 2 · cloudflare edge + stripe vault paid ($68.00)';
    if (K.lidOpen > 0.05) return 'step 1 · macbook open (110°) · order in (-20% coupon)';
    return 'step 0 · macbook lid closed (0°) · ready for order';
  },
  stats: st => {
    const K = deriveKinematics(st.t || 0);
    const stageStr = K.mailLaunch > 0.7 ? 'COMPLETED'
      : K.flapFold > 0.1 ? 'LABELED 4×6'
      : K.packProgress > 0.1 ? 'PACKING BOX'
      : K.stripeGate > 0.1 ? 'STRIPE PAID'
      : K.lidOpen > 0.05 ? 'ORDER (-20%)'
      : 'LID CLOSED';
    const netVal = K.stripePaid > 0.01 ? '$' + Math.round(68 * K.stripePaid) : '$0';
    const stockVal = K.skuPick > 0.5 ? '11 SKU' : '12 SKU';
    return [
      { label: 'Order Stage', value: stageStr, small: true },
      { label: 'Stripe Net',  value: netVal },
      { label: 'D1 Inventory',value: stockVal, small: true },
    ];
  },
  buttons: [
    { label: 'Auto-Play Full Order',            onClick: st => toggleAutoPlay(st) },
    { label: '1. Open MacBook & Order In',      onClick: st => animateToTime(st, STEP_TIMES[1]) },
    { label: '2. Authorize Stripe Payment',     onClick: st => animateToTime(st, STEP_TIMES[2]) },
    { label: '3. Pick Inventory & Pack Box',    onClick: st => animateToTime(st, STEP_TIMES[3]) },
    { label: '4. Tape Box & Slap Thermal Label',onClick: st => animateToTime(st, STEP_TIMES[4]) },
    { label: '5. Throw in the Mail',            onClick: st => animateToTime(st, STEP_TIMES[5]) },
    { label: 'Reset (Close Lid)',               onClick: st => animateToTime(st, STEP_TIMES[0], 600) },
  ],
  acts: {
    macbook: st => {
      const next = st.t < 0.10 ? STEP_TIMES[1] : st.t < 0.30 ? STEP_TIMES[2] : STEP_TIMES[0];
      animateToTime(st, next);
    },
    printer: st => animateToTime(st, STEP_TIMES[4]),
    box:     st => animateToTime(st, st.t < 0.50 ? STEP_TIMES[3] : STEP_TIMES[4]),
    chute:   st => animateToTime(st, STEP_TIMES[5]),
  },
  scrub: (st, tNorm) => {
    st.autoPlay = false;
    animId++;
    st.t = clamp01(tNorm);
    syncChoreoBar(st);
  },
  params: (st, q) => {
    if (q.has('step')){
      const s = Math.max(0, Math.min(5, +q.get('step') | 0));
      st.t = STEP_TIMES[s] ?? 0;
    }
    if (q.has('t')){
      st.t = clamp01(+q.get('t') || 0);
    }
  },
});

// Mount Mode C Choreographed Timeline Scrubber Bar below the stage
(() => {
  const rootEl = ui.rootEl || document.body;
  const stageEl = rootEl.querySelector('.stage');
  if (!stageEl) return;
  const bar = document.createElement('div');
  bar.className = 'dk-choreo-bar';
  bar.innerHTML = `
    <div class="dk-cues">
      ${CUES.map(c => `<button class="dk-cue" data-step="${c.step}" data-at="${c.at}" data-r0="${c.range[0]}" data-r1="${c.range[1]}">${c.short}</button>`).join('')}
    </div>
    <div class="dk-scrub">
      <span>CHOREO TIMELINE</span>
      <input id="dk-slider" type="range" min="0" max="1" step="0.005" value="${ui.st.t || 0}" aria-label="Timeline scrubber">
      <span id="dk-time">T = ${(ui.st.t || 0).toFixed(2)}</span>
    </div>
  `;
  stageEl.after(bar);
  bar.querySelectorAll('.dk-cue').forEach(btn => {
    btn.onclick = () => animateToTime(ui.st, +btn.dataset.at);
  });
  const slider = bar.querySelector('#dk-slider');
  slider.oninput = e => {
    ui.setTime(+e.target.value);
  };
  syncChoreoBar(ui.st);
})();

xrMount(() => ui, xrCaption);

    const fig = rootEl.querySelector('#fig');
    if (fig) {
      const lg = document.createElement('div');
      lg.className = 'lgd';
      fig.parentNode.insertBefore(lg, fig.nextSibling);
      let sig = '', q = 0;
      const upd = () => {
        q = 0;
        const m = new Map();
        if (innerWidth <= 560) {
          for (const g of fig.querySelectorAll('.tag[data-n]')) {
            const n = +g.dataset.n;
            if (!m.has(n)) m.set(n, [g.dataset.t, g.classList.contains('on')]);
          }
        }
        const a = [...m].sort((x, y) => x[0] - y[0]);
        const s = JSON.stringify(a);
        if (s === sig) return;
        sig = s;
        lg.classList.toggle('has', a.length > 0);
        lg.innerHTML = a.map(([n, [t, on]]) => `<button data-n="${n}" class="${on ? 'on' : ''}"><b>${n}</b><span>${t}</span></button>`).join('');
      };
      new MutationObserver(() => { if (!q) q = requestAnimationFrame(upd); }).observe(fig, { childList: true, subtree: true });
      addEventListener('resize', () => { if (!q) q = requestAnimationFrame(upd); });
      upd();
    }
  } finally {
    window.__EMDASH_MOTION_TARGET = null;
  }
})();
</script>
