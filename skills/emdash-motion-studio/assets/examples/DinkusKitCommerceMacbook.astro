/* ---------- 38-PART MINIATURE "COMMERCE FACTORY" INSIDE MACBOOK & PRINTER ---------- */
function commerceMech(st, K){
  const parts = [];
  const put = (b, svg) => parts.push({ box: b, svg });
  const bx = (x0, y0, z0, x1, y1, z1, m, w = 0.75) =>
    put([[x0, y0, z0], [x1, y1, z1]], box(x0, y0, z0, x1, y1, z1, m, toneI, w));
  const vc = (x, y, z0, z1, r, m, w = 0.8, n = 16) =>
    put([[x - r, y - r, z0], [x + r, y + r, z1]], cyl(x, y, z0, z1, r, m, toneI, w, n));

  // ---- 1. CHASSIS FLOOR, POWER RAIL, HEATPIPE & CENTRAL SOC (Parts 1-4) ----
  bx(25.5, 95.5, BH + 0.3, 70.5, 150.5, BH + 0.8, SPACE, 0.8);                        // Part 1: CNC Unibody floor plate
  bx(26.2, 143, BH + 0.8, 29.5, 149.5, BH + 3.4, BRASS, 0.7);                         // Part 2: MagSafe / DC power bus block
  bx(26.2, 98, BH + 3.2, 28.4, 142, BH + 4.4, matOf('#b87343'), 0.7);                 // Part 3: Copper thermal heatpipe manifold
  bx(43, 116, BH + 0.8, 52, 125, BH + 2.4, DARK, 0.8);                                // Part 4: DinkusKit Commerce SoC die

  // ---- 2. MODULE 1: CLOUDFLARE EDGE TURBINE & ROUTER (x=28..41, y=132..149, Parts 5-10) ----
  const cfActive = K.lidOpen > 0.3;
  bx(24.2, 139, BH + 1.2, 27.2, 144, BH + 3.8, METAL, 0.7);                           // Part 5: Rear fiber ingress port
  bx(28.5, 139, BH + 0.8, 34.0, 147.5, BH + 4.2, cfActive ? CF_ORG : SPACE, 0.75);    // Part 6: Edge router gateway block
  vc(37.5, 137.5, BH + 0.8, BH + 4.4, 3.6, ALUM, 0.85, 18);                           // Part 7: Cloudflare Edge turbine stator ring
  // Part 8: Spinning axial turbine rotor hub + 6 vanes
  {
    const cx = 37.5, cy = 137.5, cz = BH + 4.5, ang0 = K.edgeSpin;
    let vanes = cyl(cx, cy, BH + 4.4, BH + 5.3, 1.5, CF_ORG, toneI, 0.7, 12);
    for (let i = 0; i < 6; i++){
      const a = ang0 + (i / 6) * Math.PI * 2;
      vanes += line([[cx + 1.2*Math.cos(a), cy + 1.2*Math.sin(a), cz + 0.3], [cx + 3.2*Math.cos(a), cy + 3.2*Math.sin(a), cz + 0.3]], 0.9);
    }
    put([[cx - 3.6, cy - 3.6, BH + 4.4], [cx + 3.6, cy + 3.6, BH + 5.5]], vanes);
  }
  vc(30.5, 134, BH + 0.8, BH + 4.0, 1.2, BRASS, 0.65, 12);                            // Part 9: Edge WAF filter capacitor 1
  vc(33.2, 134, BH + 0.8, BH + 4.0, 1.2, BRASS, 0.65, 12);                            // Part 10: Edge WAF filter capacitor 2

  // ---- 3. MODULE 2: MARKETING FUNNEL & COUPON STAMP PRESS (x=45..67, y=131..149, Parts 11-17) ----
  // Part 11: Conical Marketing Funnel hopper
  vc(48.5, 143.5, BH + 0.8, BH + 3.0, 1.8, METAL, 0.7, 14);
  put([[45.5, 140.5, BH + 3.0], [51.5, 146.5, BH + 5.8]],
    rod([48.5, 143.5, BH + 3.0], [48.5, 143.5, BH + 5.6], 1.6, CF_ORG, toneI, 0.85, 3.1, 16));
  // Part 12: Marketing funnel traffic sphere dropping in
  {
    const tz = BH + 5.9 - K.lidOpen * 1.4;
    vc(48.5, 143.5, tz - 0.8, tz + 0.4, 0.9, BRASS, 0.6, 10);
  }
  // Part 13: Cart conveyor bed running from Marketing Funnel under Coupon Stamp Press
  bx(51.5, 134, BH + 0.8, 66.5, 142, BH + 1.9, SPACE, 0.75);
  // Part 14 & 15: Coupon Stamp Press twin vertical guide columns & upper yoke bridge
  vc(57.0, 134.8, BH + 1.9, BH + 5.9, 0.65, METAL, 0.6, 10);
  vc(63.0, 134.8, BH + 1.9, BH + 5.9, 0.65, METAL, 0.6, 10);
  bx(56.0, 134.0, BH + 5.2, 64.0, 141.5, BH + 6.2, CRIM, 0.8);
  // Part 16: Plunging -20% Coupon Stamp actuator head
  {
    const dz = K.couponStamp * 2.1;
    bx(57.8, 135.8, BH + 3.2 - dz, 62.2, 140.2, BH + 5.1 - dz, K.couponApplied > 0.3 ? CRIM : BRASS, 0.75);
  }
  // Part 17: Cart coupon ticket on the conveyor bed (stamped crimson when couponApplied > 0.3)
  bx(57.2, 135.6, BH + 1.95, 62.8, 140.4, BH + 2.45, K.couponApplied > 0.3 ? CRIM : CERAMIC, 0.65);

  // ---- 4. MODULE 3: STRIPE VAULT GATE & SETTLEMENT LEDGER CYLINDERS (x=29..42, y=109..128, Parts 18-23) ----
  const paidMat = K.stripePaid > 0.5 ? STRIPE : AIZOME;
  bx(29.5, 116, BH + 0.8, 39.5, 126.5, BH + 5.4, paidMat, 0.85);                      // Part 18: Armored Stripe Vault chamber
  // Part 19: Vault rotary locking gate on front face (x = 39.5..41.2)
  {
    const openShift = K.stripeGate * 2.4;
    bx(39.6, 117.5 - openShift, BH + 1.3, 41.2, 124.5 - openShift, BH + 4.9, METAL, 0.8);
  }
  // Parts 20, 21, 22: 3 Settlement Ledger Cylinders (rise with stripePaid)
  const ledH = 2.6 + K.stripePaid * 1.8;
  vc(31.5, 111.5, BH + 0.8, BH + 0.8 + ledH, 1.35, BRASS, 0.7, 12);                   // Part 20: Ledger cylinder 1
  vc(35.0, 111.5, BH + 0.8, BH + 0.8 + ledH, 1.35, STRIPE, 0.7, 12);                  // Part 21: Ledger cylinder 2
  vc(38.5, 111.5, BH + 0.8, BH + 0.8 + ledH, 1.35, BRASS, 0.7, 12);                   // Part 22: Ledger cylinder 3
  bx(40.2, 110.0, BH + 0.8, 43.2, 114.5, BH + 3.4, PCB_M, 0.7);                       // Part 23: Stripe HSM webhook chip

  // ---- 5. MODULE 4: D1 INVENTORY RACK CAROUSEL & SKU PICKER (x=52..68, y=104..125, Parts 24-29) ----
  bx(53.0, 105.0, BH + 0.8, 67.5, 124.0, BH + 1.5, METAL, 0.75);                      // Part 24: D1 Rack lower shelf
  bx(53.0, 105.0, BH + 3.3, 67.5, 124.0, BH + 3.9, METAL, 0.75);                      // Part 25: D1 Rack upper shelf
  // Parts 26, 27, 28: SKU Bins on the rack (Part 28 slides out +x during Step 3 skuPick!)
  bx(54.5, 118.0, BH + 1.5, 59.5, 122.8, BH + 3.2, KRAFT, 0.7);                       // Part 26: Stock SKU bin A
  bx(54.5, 112.0, BH + 1.5, 59.5, 116.8, BH + 3.2, KRAFT, 0.7);                       // Part 27: Stock SKU bin B
  {
    const dx = K.skuPick * 4.2;
    bx(60.5 + dx, 106.5, BH + 1.5, 65.5 + dx, 111.5, BH + 3.2, AIZOME, 0.75);         // Part 28: Active picked SKU bin (-1 SKU)
  }
  vc(51.2, 107.5, BH + 0.8, BH + 4.4, 1.3, SPACE, 0.7, 12);                           // Part 29: D1 Carousel stepper drive motor

  // ---- 6. MODULE 5: EMAIL PNEUMATIC TUBE RECEIPT LAUNCHER (x=29..49, y=96..106, Parts 30-33) ----
  vc(31.5, 100.5, BH + 0.8, BH + 5.0, 2.1, BRASS, 0.8, 16);                           // Part 30: Pneumatic compressor cylinder
  bx(34.2, 98.5, BH + 0.8, 38.0, 102.5, BH + 4.0, PCB_M, 0.7);                        // Part 31: Solenoid launch valve manifold
  put([[38.0, 98.8, BH + 2.0], [49.0, 102.2, BH + 4.4]],
    cylX(38.0, 49.0, 100.5, BH + 3.2, 1.25, CLEAR, toneI, 0.75, 14));                 // Part 32: Transparent pneumatic dispatch tube
  // Part 33: Glowing Email Confirmation Capsule shooting through the pneumatic tube
  {
    const capX = 38.8 + K.emailPulse * 8.4;
    put([[capX - 1.2, 99.4, BH + 2.2], [capX + 1.2, 101.6, BH + 4.2]],
      cylX(capX - 1.1, capX + 1.1, 100.5, BH + 3.2, 0.9, K.emailPulse > 0.05 ? CF_ORG : BRASS, toneI, 0.7, 12));
  }

  // ---- 7. MODULE 6: USB-C BUS & PITNEY BOWES THERMAL PRINT HEAD / LABEL ROLL (Parts 34-38) ----
  bx(41.5, 94.2, BH + 0.8, 47.5, 98.0, BH + 3.8, AIZOME, 0.75);                       // Part 34: MacBook USB-C Bus controller
  bx(33.0, 78.0, BH + 0.8, 39.5, 83.2, BH + 5.2, PCB_M, 0.75);                        // Part 35: Printer internal USB-C logic board
  // Part 36: Internal 4x6 Label Roll media spool inside Pitney Bowes printer
  {
    let roll = '';
    const r0 = 5.0 - K.labelFlight * 0.4;
    const A = on(PY(60), ellUV(29, BH + 8.5, r0, r0, 20));
    const B = on(PY(76), ellUV(29, BH + 8.5, r0, r0, 20));
    roll += loft(A, B, nr => toneI(nr, CERAMIC)) + fill(pd(A), CERAMIC.l) + fill(pd(B), CERAMIC.m) + hullInk([...A, ...B], 1.0);
    // Inner cardboard core
    const C0 = on(PY(59.5), ellUV(29, BH + 8.5, 1.8, 1.8, 14));
    const C1 = on(PY(76.5), ellUV(29, BH + 8.5, 1.8, 1.8, 14));
    roll += loft(C0, C1, nr => toneI(nr, KRAFT)) + fill(pd(C0), KRAFT.d);
    put([[23.5, 59.5, BH + 3.0], [34.5, 76.5, BH + 14.0]], roll);
  }
  // Part 37: Rubber platen drive roller & brass stepper gear
  {
    const A = on(PY(59), ellUV(43.5, BH + 8.2, 2.2, 2.2, 16));
    const B = on(PY(77), ellUV(43.5, BH + 8.2, 2.2, 2.2, 16));
    const s = loft(A, B, nr => toneI(nr, DARK)) + fill(pd(A), BRASS.l) + hullInk([...A, ...B], 0.9);
    put([[41.0, 59.0, BH + 5.8], [46.0, 77.0, BH + 10.6]], s);
  }
  // Part 38: Heated Thermal Print Head bar above platen roller (glows amber-red during Step 4)
  bx(41.5, 59.0, BH + 11.0, 46.2, 77.0, BH + 13.5, K.printHeat > 0.1 ? CRIM : CF_ORG, 0.85);

  // ---- PORT-TO-PORT INTERNAL WIRING HARNESSES ----
  const liveCol = K.stripePaid > 0.3 ? '#f79640' : '#3a4654';
  parts.push(...wireSegs([[34.0, 143.0, BH + 1.6], [45.5, 143.0, BH + 1.6]], '#f79640', 0.45));
  parts.push(...wireSegs([[57.0, 134.0, BH + 1.4], [48.0, 125.0, BH + 1.4], [39.5, 121.0, BH + 1.4]], liveCol, 0.45));
  parts.push(...wireSegs([[39.5, 118.0, BH + 1.4], [53.0, 115.0, BH + 1.4]], K.stripePaid > 0.5 ? '#2ea874' : '#3a4654', 0.45));
  parts.push(...wireSegs([[47.5, 116.0, BH + 1.3], [44.5, 102.0, BH + 1.3], [38.0, 100.5, BH + 1.3]], K.emailPulse > 0.05 ? '#f2c96b' : '#3a4654', 0.45));
  parts.push(...wireSegs([[53.0, 108.0, BH + 1.2], [44.5, 98.0, BH + 1.2]], K.printHeat > 0.05 ? '#f79640' : '#3568b0', 0.5));

  return byDepth(parts);
}

/* ---------- 1. MACBOOK PRO (Hinged Lid 0°..110° + Live DinkusKit Storefront) ---------- */
function drawMacbookBase(st, K, m){
  const x0 = 24, x1 = 72, y0 = 94, y1 = 152, z0 = BH, z1 = BH + 6.5;
  const prof = rrUV(y0, z0, y1, z1, 1.4, 5);
  let body = '';
  const FRONT = facing([1, 0, 0]), BACK = facing([-1, 0, 0]), RIGHT = facing([0, -1, 0]), LEFT = facing([0, 1, 0]);

  body += extrude(prof, x0, x1, ALUM, tone);
  if (FRONT){
    body += shape(on(PX(x1), prof), tone([1, 0, 0], ALUM), 1.0);
    // Front thumb notch indent on the unibody lip
    body += shape(on(PX(x1 + 0.06), rectUV(116, z1 - 1.3, 130, z1)), SPACE.d, 0.6);
  }
  if (BACK){
    body += shape(on(PX(x0), prof), tone([-1, 0, 0], ALUM), 1.0);
    // Rear thermal exhaust vents & model engraving
    for (let y = 104; y <= 140; y += 6){
      body += shape(on(PX(x0 - 0.06), rectUV(y, z0 + 1.8, y + 3.5, z0 + 3.4)), SPACE.d, 0.5);
    }
  }
  if (RIGHT){
    // Right side (y = y0 = 94): Two USB-C Thunderbolt ports + headphone jack
    body += shape(on(PY(y0 - 0.05), rrUV(36, z0 + 2.2, 39.5, z0 + 3.8, 0.5)), SPACE.d, 0.6);
    body += shape(on(PY(y0 - 0.05), rrUV(42.5, z0 + 2.2, 46.0, z0 + 3.8, 0.5)), CF_ORG.m, 0.6);
  }
  if (LEFT){
    // Left side (y = y1 = 152): MagSafe 3 port + dual USB-C ports
    body += shape(on(PY(y1 + 0.05), rrUV(30, z0 + 2.2, 34, z0 + 3.8, 0.5)), BRASS.m, 0.6);
    body += shape(on(PY(y1 + 0.05), rrUV(37, z0 + 2.2, 40.5, z0 + 3.8, 0.5)), SPACE.d, 0.6);
  }

  // Top deck: recessed black magic keyboard well + speaker grilles + Force Touch trackpad
  const topFace = on(PZ(z1 + 0.02), rrUV(x0 + 1.2, y0 + 1.2, x1 - 1.2, y1 - 1.2, 2.2));
  body += fill(pd(topFace), ALUM.l) + ink(pd(topFace), 0.8);
  // Keyboard well (x = 29..54, y = 100..146)
  const kbWell = on(PZ(z1 + 0.06), rrUV(29, 100, 54, 146, 1.2));
  body += shape(kbWell, '#1e2229', 0.8);
  // Keycap rows inside keyboard well
  for (let r = 0; r < 5; r++){
    const rx0 = 30.2 + r * 4.6, rx1 = rx0 + 3.7;
    for (let c = 0; c < 10; c++){
      const cy0 = 101.5 + c * 4.35, cy1 = cy0 + 3.6;
      body += fill(pd(on(PZ(z1 + 0.1), rectUV(rx0, cy0, rx1, cy1))), '#2d333d');
    }
  }
  // Force Touch Trackpad (x = 56..69, y = 112..134)
  body += shape(on(PZ(z1 + 0.06), rrUV(56, 112, 69, 134, 1.2)), '#cfd6de', 0.75);
  body += hullInk([...on(PX(x0), prof), ...on(PX(x1), prof)], 2.4);

  const k = ease(st.xr || 0);
  if (k > 0){
    body = xrGhost(body, '', k, prof, x0, x1, ALUM) + `<g opacity="${f(k)}">${commerceMech(st, K)}</g>`;
  }
  return act('macbook', body);
}

function drawMacbookLid(st, K, m){
  // Hinges along rear edge (xH = 25.5, y = 94..152, zH = BH + 6.6)
  // Lid angle: 0 deg = flat closed over base (t=0); 110 deg = open angled back
  const xH = 25.5, y0 = 94, y1 = 152, zH = BH + 6.6;
  const deg = K.lidOpen * 110;
  const rad = deg * Math.PI / 180;
  const L_lid = 45.5, T_lid = 1.6;
  // Unit vector u along lid from hinge toward top edge; n normal pointing from screen toward outer shell
  const ux = Math.cos(rad), uz = Math.sin(rad);
  const nx = -Math.sin(rad), nz = Math.cos(rad);
  const lidPt = (s, y, w) => [xH + s * ux + w * nx, y, zH + s * uz + w * nz];

  const c000 = lidPt(0, y0, 0), c100 = lidPt(L_lid, y0, 0), c110 = lidPt(L_lid, y1, 0), c010 = lidPt(0, y1, 0);
  const c001 = lidPt(0, y0, T_lid), c101 = lidPt(L_lid, y0, T_lid), c111 = lidPt(L_lid, y1, T_lid), c011 = lidPt(0, y1, T_lid);

  const innerFace = [c000, c100, c110, c010];
  const outerFace = [c001, c011, c111, c101];
  const screenNorm = [-nx, 0, -nz];
  const backNorm   = [nx, 0, nz];
  const screenVis  = vis(screenNorm);

  let s = '';
  // Draw back/outer shell + perimeter rim
  s += loft(innerFace, [c001, c101, c111, c011], nr => tone(nr, ALUM));
  if (vis(backNorm)){
    s += shape(outerFace, tone(backNorm, ALUM), 1.0);
    // DinkusKit diamond emblem on outer aluminum lid (visible when closed at t=0 or from behind!)
    const em = [
      lidPt(L_lid * 0.44, 123, T_lid + 0.06),
      lidPt(L_lid * 0.50, 118.5, T_lid + 0.06),
      lidPt(L_lid * 0.56, 123, T_lid + 0.06),
      lidPt(L_lid * 0.50, 127.5, T_lid + 0.06),
    ];
    s += shape(em, AIZOME.l, 0.8);
  }

  // Inner Retina Display when facing viewer and lid is opening
  if (screenVis && K.lidOpen > 0.04){
    s += shape(innerFace, '#141821', 1.0);
    const padS = 2.6, padY = 2.8;
    const scr = [
      lidPt(padS, y0 + padY, -0.05),
      lidPt(L_lid - padS, y0 + padY, -0.05),
      lidPt(L_lid - padS, y1 - padY, -0.05),
      lidPt(padS, y1 - padY, -0.05),
    ];
    s += shape(scr, K.screenOn > 0.1 ? '#f4f1ea' : '#1d2430', 0.8);

    if (K.screenOn > 0.15){
      // Top Storefront Header Bar on the Retina Display (near s = L_lid - 5)
      const hdr = [
        lidPt(L_lid - 7.5, y0 + padY + 0.8, -0.09),
        lidPt(L_lid - 3.2, y0 + padY + 0.8, -0.09),
        lidPt(L_lid - 3.2, y1 - padY - 0.8, -0.09),
        lidPt(L_lid - 7.5, y1 - padY - 0.8, -0.09),
      ];
      s += fill(pd(hdr), '#1b222c');

      // Left Storefront Product Card (y = 124..147, s = 10..35)
      const cardL = [
        lidPt(10, 124, -0.09),
        lidPt(35, 124, -0.09),
        lidPt(35, 147, -0.09),
        lidPt(10, 147, -0.09),
      ];
      s += shape(cardL, '#e4dfd3', 0.65);

      // Product preview icon inside storefront card
      const prodIcon = [
        lidPt(17, 130, -0.13),
        lidPt(29, 130, -0.13),
        lidPt(29, 141, -0.13),
        lidPt(17, 141, -0.13),
      ];
      s += shape(prodIcon, AIZOME.l, 0.6);

      // Right Checkout & Order Status Panel (y = 98..121, s = 10..35)
      const cardR = [
        lidPt(10, 98, -0.09),
        lidPt(35, 98, -0.09),
        lidPt(35, 121, -0.09),
        lidPt(10, 121, -0.09),
      ];
      s += shape(cardR, '#ffffff', 0.65);

      // Coupon Badge (-20% SAVE20) when stamped in Step 1
      if (K.couponApplied > 0.2){
        const cpn = [
          lidPt(26, 100, -0.14),
          lidPt(33, 100, -0.14),
          lidPt(33, 119, -0.14),
          lidPt(26, 119, -0.14),
        ];
        s += shape(cpn, CRIM.l, 0.65);
      }

      // Stripe Paid / Fulfilled Status Banner inside checkout panel
      const payCol = K.mailLaunch > 0.5 ? '#2b5b9e' : K.stripePaid > 0.4 ? '#2ea874' : '#f4b829';
      const payBar = [
        lidPt(12, 100, -0.14),
        lidPt(19, 100, -0.14),
        lidPt(19, 119, -0.14),
        lidPt(12, 119, -0.14),
      ];
      s += shape(payBar, payCol, 0.65);

      // Crisp 3D text projected directly on the angled Retina display plane
      const txLid = (sPos, yPos, wOff, str, sz, col, weight = 800) => {
        const o = P(...lidPt(sPos, yPos, wOff));
        return `<text transform="${txM(o, Dv(0, -1, 0), Dv(-ux, 0, -uz))}" font-size="${sz}" fill="${col}" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-weight="${weight}" letter-spacing=".04em">${str}</text>`;
      };
      s += txLid(L_lid - 5.8, 123, -0.18, 'DINKUSKIT.STORE', 2.5, '#f4f1ea', 800);

      if (K.couponApplied > 0.2){
        s += txLid(29.0, 109.5, -0.2, '-20% PROMO', 2.2, '#ffffff', 800);
      }
      const statusStr = K.mailLaunch > 0.5 ? 'COMPLETED' : K.stripePaid > 0.4 ? 'PAID $68' : 'ORDER #1042';
      const statusCol = K.mailLaunch > 0.5 || K.stripePaid > 0.4 ? '#ffffff' : '#1b222c';
      s += txLid(15.0, 109.5, -0.2, statusStr, 2.2, statusCol, 800);
    }
  }

  s += hullInk([...innerFace, ...outerFace], 2.2);
  const allPts = [...innerFace, ...outerFace];
  return {
    box: boxOfPts(allPts, 0.2),
    svg: act('macbook', s),
  };
}

/* ---------- 2. BRAIDED USB-C CABLE & PITNEY BOWES 4×6 THERMAL PRINTER ---------- */
function drawUsbCable(K){
  const pts = [
    [44, 94.0, BH + 2.8],
    [44, 90.0, BH + 1.4],
    [41, 87.5, BH + 0.6],
    [37, 85.5, BH + 1.2],
    [36, 84.0, BH + 2.6],
  ];
  const d = pd(pts, false);
  const active = K.printHeat > 0.05 || K.labelFlight > 0.01;
  const svg = box(42.5, 92.5, BH + 1.8, 45.5, 94.2, BH + 3.6, DARK, toneI, 0.7)
    + box(34.5, 83.8, BH + 1.8, 37.5, 85.5, BH + 3.6, DARK, toneI, 0.7)
    + `<path d="${d}" fill="none" stroke="${INK}" stroke-width="${f(3.6 * INK_K)}" stroke-linecap="round" stroke-linejoin="round"/>`
    + `<path d="${d}" fill="none" stroke="${active ? '#f79640' : '#2b5b9e'}" stroke-width="${f(2.0 * INK_K)}" stroke-dasharray="3 2" stroke-linecap="round"/>`;
  return {
    box: [[34, 83.8, BH], [46, 94.0, BH + 4.2]],
