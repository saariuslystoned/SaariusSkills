{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saarius.example/schemas/custom-agent-capability-v1.json",
  "title": "Custom-agent capability fingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "captured_at",
    "source",
    "historical_pr6_head",
    "surface",
    "cli",
    "host",
    "invocation",
    "isolation",
    "agents",
    "observer",
    "budget"
  ],
  "properties": {
    "schema": {
      "const": "saarius.custom-agent-capability.v1"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "branch", "base_sha", "head_sha", "issue"],
      "properties": {
        "repo": {"const": "saariuslystoned/SaariusSkills"},
        "branch": {"type": "string", "minLength": 1},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "issue": {"const": 15}
      }
    },
    "historical_pr6_head": {
      "const": "baea84b2bb0d21ff749ce65d077a76cc76f2e1de"
    },
    "surface": {
      "enum": ["cli"]
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_class", "version", "binary_sha256"],
      "properties": {
        "path_class": {"enum": ["worker-user-local", "homebrew"]},
        "version": {"type": "string", "minLength": 1},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "taxonomy", "os", "arch"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "taxonomy": {"enum": ["worker_host", "operator_terminal"]},
        "os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort",
        "sandbox",
        "skip_permissions",
        "fresh_session",
        "prompt_transport"
      ],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "effort": {"enum": ["low", "medium", "high"]},
        "sandbox": {"const": true},
        "skip_permissions": {"const": false},
        "fresh_session": {"const": true},
        "prompt_transport": {
          "enum": [
            "tmux-buffer-stdin",
            "print-stdin",
            "print-argument-challenge-only"
          ]
        },
        "workspace_binding": {"const": "add-dir-absolute"},
        "execution_mode": {"const": "accept-edits"}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "global_agent_write",
        "foreign_resume",
        "foreign_cleanup"
      ],
      "properties": {
        "workspace": {"const": "disposable"},
        "global_agent_write": {"const": false},
        "foreign_resume": {"const": false},
        "foreign_cleanup": {"const": false}
      }
    },
    "agents": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "definition_sha256", "role_marker"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "definition_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role_marker": {"type": "string", "minLength": 1}
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "actor_ids",
        "raw_transcript_read",
        "raw_log_retained",
        "tool_policy"
      ],
      "properties": {
        "schema": {"const": "saarius.custom-agent-event.v1"},
        "actor_ids": {
          "enum": ["run-salted-sha256", "not-collected"]
        },
        "raw_transcript_read": {"const": false},
        "raw_log_retained": {"const": false},
        "tool_policy": {
          "enum": [
            "one-write-to-file-exact-result-all-else-deny",
            "profile-write-only-plus-external-quarantine-postflight"
          ]
        },
        "packaging": {
          "enum": ["workspace-plugin", "external-controller"]
        },
        "plugin_name": {"const": "saarius-issue15-observer"},
        "harness_path_mode": {
          "enum": ["absolute-environment", "exact-commit-copy"]
        },
        "profile_quarantine": {"const": "before-model-write"},
        "raw_output_policy": {"const": "digest-then-unlink"},
        "selection_guard": {
          "const": "exact-name-occurrence-count-before-model"
        },
        "discovery_output_policy": {
          "const": "digest-in-memory-not-retained"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_sessions",
        "max_invocations",
        "max_wall_seconds",
        "per_session_seconds"
      ],
      "properties": {
        "max_sessions": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_invocations": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 720},
        "per_session_seconds": {"type": "integer", "minimum": 1, "maximum": 90}
      }
    }
  }
}
