{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saarius.example/schemas/custom-agent-behavior-report-v1.json",
  "title": "Custom-agent behavior report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "overall_behavior",
    "overall_confidence",
    "capability_fingerprint_sha256",
    "contract",
    "checks",
    "anti_cheat_probes",
    "blockers",
    "cleanup"
  ],
  "properties": {
    "schema": {
      "const": "saarius.custom-agent-behavior-report.v1"
    },
    "overall_behavior": {
      "enum": ["satisfies_contract", "violates_contract", "blocked"]
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "capability_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": {
          "enum": [
            "plans/custom-agents/BEHAVIOR_CONTRACT.md",
            "plans/custom-agents/BEHAVIOR_CONTRACT_PHASE1B.md",
            "plans/custom-agents/BEHAVIOR_CONTRACT_PHASE1C.md"
          ]
        },
        "version": {
          "enum": [
            "2026-07-26.phase1",
            "2026-07-26.phase1b",
            "2026-07-26.phase1c"
          ]
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_clause",
          "status",
          "evidence",
          "confidence"
        ],
        "properties": {
          "contract_clause": {
            "pattern": "^C[1-8]$",
            "type": "string"
          },
          "status": {
            "enum": ["pass", "fail", "blocked", "out_of_scope"]
          },
          "evidence": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "anti_cheat_probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe", "result"],
        "properties": {
          "probe": {"type": "string", "minLength": 1},
          "result": {"type": "string", "minLength": 1}
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_session",
        "owned_workspace",
        "owned_raw_log",
        "foreign_state_touched"
      ],
      "properties": {
        "owned_session": {"enum": ["clean", "preserved", "ambiguous"]},
        "owned_workspace": {"enum": ["clean", "preserved", "ambiguous"]},
        "owned_raw_log": {"enum": ["clean", "preserved", "ambiguous"]},
        "foreign_state_touched": {"const": false}
      }
    }
  }
}
