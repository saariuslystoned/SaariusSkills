#!/usr/bin/env python3
"""Pin selected upstream PStack skills and project them beside local custom skills."""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
UPSTREAM_REPO = "https://github.com/cursor/plugins.git"
UPSTREAM_SKILLS = (
    "architect", "automate-me", "blast-radius", "create-verification-skill",
    "how", "maintain-verification-skill", "reflect", "tdd", "unslop", "why",
)
CUSTOM_SKILLS = ("bobby-mode", "pstack-playbooks")


def git(source: Path, *args: str) -> bytes:
    return subprocess.run(
        ["git", "-C", str(source), *args], check=True, capture_output=True,
    ).stdout


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def files(root: Path) -> dict[str, bytes]:
    """Read one owned tree without following symlinks."""
    if root.is_symlink():
        raise ValueError(f"refusing symlink: {root}")
    if not root.exists():
        return {}
    result = {}
    for path in sorted(root.rglob("*")):
        if path.is_symlink():
            raise ValueError(f"refusing symlink: {path}")
        if path.is_file():
            result[path.relative_to(root).as_posix()] = path.read_bytes()
    return result


def safe_owned_paths(root: Path) -> None:
    for relative in ("vendor", "vendor/pstack", "pstack", "pstack/skills", "pstack/custom", "pstack/custom/skills"):
        if (root / relative).is_symlink():
            raise ValueError(f"refusing symlink: {root / relative}")


def snapshot(source: Path, ref: str) -> tuple[dict[str, bytes], dict]:
    commit = git(source, "rev-parse", "--verify", "--end-of-options", f"{ref}^{{commit}}").decode().strip()
    prefixes = [f"pstack/skills/{name}/" for name in UPSTREAM_SKILLS]
    paths = ["pstack/LICENSE", *prefixes]
    entries = git(source, "ls-tree", "-r", "-z", commit, "--", *paths).split(b"\0")
    result = {}
    for entry in entries:
        if not entry:
            continue
        meta, encoded_path = entry.split(b"\t", 1)
        mode, kind, blob = meta.decode().split()
        path = encoded_path.decode()
        if kind != "blob" or mode not in ("100644", "100755"):
            raise ValueError(f"unsupported selected upstream entry: {path} ({mode} {kind})")
        relative = Path(path).relative_to("pstack").as_posix()
        if ".." in Path(relative).parts:
            raise ValueError(f"unsafe upstream path: {path}")
        result[relative] = git(source, "cat-file", "blob", blob)
    required = {"LICENSE", *(f"skills/{name}/SKILL.md" for name in UPSTREAM_SKILLS)}
    if not required <= result.keys():
        raise ValueError(f"missing selected upstream files: {sorted(required - result.keys())}")
    available = git(source, "ls-tree", "--name-only", commit, "pstack/skills/").decode().splitlines()
    manifest = {
        "upstream": UPSTREAM_REPO,
        "source_path": "pstack",
        "ref": ref,
        "commit": commit,
        "committed_at": git(source, "show", "-s", "--format=%cI", commit).decode().strip(),
        "author": "Lauren Tan",
        "license": "MIT",
        "synced_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
        "skills": list(UPSTREAM_SKILLS),
        "excluded_skills": sorted(Path(path).name for path in available if Path(path).name not in UPSTREAM_SKILLS),
        "excluded_surfaces": ["agents", "automations", "assets", "docs", "plugin manifests"],
        "files": {path: sha256(data) for path, data in sorted(result.items())},
    }
    return result, manifest


def read_vendor(root: Path) -> tuple[dict[str, bytes], dict]:
    vendor = files(root / "vendor/pstack")
    try:
        manifest = json.loads(vendor.pop("UPSTREAM.json"))
    except (KeyError, json.JSONDecodeError) as exc:
        raise ValueError("missing or invalid vendor/pstack/UPSTREAM.json") from exc
    vendor.pop("README.md", None)
    if manifest.get("upstream") != UPSTREAM_REPO or manifest.get("skills") != list(UPSTREAM_SKILLS):
        raise ValueError("unexpected PStack provenance or selected skill set")
    if {path: sha256(data) for path, data in sorted(vendor.items())} != manifest.get("files"):
        raise ValueError("PStack vendor drift: files differ from UPSTREAM.json")
    return vendor, manifest


def expected_packages(root: Path, vendor: dict[str, bytes], manifest: dict) -> dict[str, dict[str, bytes]]:
    result = {}
    for name in UPSTREAM_SKILLS:
        prefix = f"skills/{name}/"
        package = {path[len(prefix):]: data for path, data in vendor.items() if path.startswith(prefix)}
        if "SKILL.md" not in package:
            raise ValueError(f"missing upstream skill: {name}")
        package["LICENSE"] = vendor["LICENSE"]
        package["UPSTREAM.md"] = (
            f"# Upstream source\n\nVerbatim skill content by Lauren Tan (MIT) from\n"
            f"https://github.com/cursor/plugins/tree/{manifest['commit']}/pstack/skills/{name}\n\n"
            "The package adds LICENSE and this notice. Edit the upstream pin through\n"
            "scripts/sync-pstack-skills; local custom skills have separate sources.\n"
        ).encode()
        result[name] = package
    custom_files = files(root / "pstack/custom")
    if "LICENSE" not in custom_files:
        raise ValueError("missing pstack/custom/LICENSE")
    custom_license = custom_files["LICENSE"]
    for name in CUSTOM_SKILLS:
        package = files(root / "pstack/custom/skills" / name)
        if "SKILL.md" not in package:
            raise ValueError(f"missing custom skill source: {name}")
        package["LICENSE"] = custom_license
        package["SOURCE.md"] = (
            f"# Local source\n\nThis is a Saarius customization, not an upstream PStack skill.\n"
            f"Edit pstack/custom/skills/{name}/, then run scripts/sync-pstack-skills --package.\n"
            "Upstream refreshes do not replace this source.\n"
        ).encode()
        result[name] = package
    return result


def validate_packages(root: Path, expected: dict[str, dict[str, bytes]]) -> list[str]:
    destination = root / "pstack/skills"
    existing = {p.name for p in destination.iterdir() if p.is_dir()} if destination.exists() else set()
    if existing - expected.keys():
        raise ValueError(f"unexpected packaged skills: {sorted(existing - expected.keys())}")
    return [name for name, content in expected.items() if files(destination / name) != content]


def write_tree(destination: Path, content: dict[str, bytes]) -> None:
    # Callers preflight all owned trees before the first write. Custom sources
    # are never destinations, and unrelated skill directories are never removed.
    previous = files(destination)
    destination.mkdir(parents=True, exist_ok=True)
    for relative in previous.keys() - content.keys():
        (destination / relative).unlink()
    for relative, data in content.items():
        path = destination / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)


def discovery(root: Path) -> None:
    names = set(UPSTREAM_SKILLS + CUSTOM_SKILLS)
    manifest = json.loads((root / "pstack/.codex-plugin/plugin.json").read_text())
    if manifest.get("name") != "pstack-saarius" or manifest.get("skills") != "./skills/":
        raise ValueError("PStack plugin identity or discovery path changed")
    cursor = json.loads((root / ".cursor-plugin/plugin.json").read_text())
    for name in names:
        link = root / "skills" / name
        if not link.is_symlink() or link.readlink() != Path("../pstack/skills") / name:
            raise ValueError(f"unexpected root discovery link: {name}")
        if f"./skills/{name}/" not in cursor.get("skills", []):
            raise ValueError(f"missing Cursor discovery entry: {name}")


def package(root: Path = ROOT, check_only: bool = False) -> int:
    safe_owned_paths(root)
    vendor, manifest = read_vendor(root)
    expected = expected_packages(root, vendor, manifest)
    drift = validate_packages(root, expected)
    discovery(root)
    if check_only and drift:
        raise ValueError("PStack package drift: " + ", ".join(drift))
    if not check_only:
        for name in drift:
            write_tree(root / "pstack/skills" / name, expected[name])
    print(f"PStack {'check clean' if check_only else 'packaged'}: 10 upstream + 2 custom skills; {manifest['commit']}")
    return 0


def update(source: Path, ref: str, root: Path = ROOT, requested_ref: str | None = None) -> int:
    safe_owned_paths(root)
    # An upstream refresh must not erase later edits to generated output. Local
    # source edits use explicit --package first; unexpected output edits need
    # reconciliation instead of silently choosing either copy.
    if (root / "vendor/pstack/UPSTREAM.json").exists():
        previous, previous_manifest = read_vendor(root)
        previous_packages = expected_packages(root, previous, previous_manifest)
        drift = validate_packages(root, previous_packages)
        if drift:
            raise ValueError("package drift before upstream refresh; reconcile local sources then --package: " + ", ".join(drift))
    vendor, manifest = snapshot(source, ref)
    if requested_ref is not None:
        manifest["ref"] = requested_ref
    expected = expected_packages(root, vendor, manifest)
    for name in CUSTOM_SKILLS:
        actual = files(root / "pstack/skills" / name)
        original = {path: data for path, data in expected[name].items() if path not in ("LICENSE", "SOURCE.md")}
        if actual and {path: data for path, data in actual.items() if path not in ("LICENSE", "SOURCE.md")} != original:
            raise ValueError(f"custom package drift before upstream refresh: {name}")
    validate_packages(root, expected)
    discovery(root)
    old_vendor = files(root / "vendor/pstack")
    if "README.md" in old_vendor:
        vendor["README.md"] = old_vendor["README.md"]
    vendor["UPSTREAM.json"] = (json.dumps(manifest, indent=2) + "\n").encode()
    write_tree(root / "vendor/pstack", vendor)
    for name, content in expected.items():
        write_tree(root / "pstack/skills" / name, content)
    print(f"PStack updated: 10 upstream + 2 custom skills; {manifest['commit']}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true", help="Check vendor hashes, packaged content and discovery without writes.")
    mode.add_argument("--package", action="store_true", help="Regenerate package from the verified pin and local custom sources; no network.")
    mode.add_argument("--update", action="store_true", help="Refresh only the ten selected upstream skills, preserving custom sources.")
    parser.add_argument("--source", type=Path, help="Read committed objects from this local upstream clone, ignoring its working files.")
    parser.add_argument("--ref", help="Exact upstream commit or ref; defaults to main (HEAD with --source).")
    args = parser.parse_args()
    if not args.update and (args.source is not None or args.ref is not None):
        parser.error("--source and --ref apply only to --update")
    try:
        if not args.update:
            return package(check_only=args.check)
        if args.source:
            return update(args.source.resolve(), args.ref or "HEAD")
        with tempfile.TemporaryDirectory(prefix="pstack-upstream-") as temp:
            source = Path(temp)
            subprocess.run(["git", "init", "--quiet", str(source)], check=True)
            subprocess.run(["git", "-C", str(source), "fetch", "--quiet", "--depth", "1", "--", UPSTREAM_REPO, args.ref or "main"], check=True)
            return update(source, "FETCH_HEAD", requested_ref=args.ref or "main")
    except (ValueError, OSError, subprocess.CalledProcessError) as exc:
        print(f"PStack sync failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
