  "keywords": [
    "agent-skills",
    "grilltrack",
    "product-development",
    "cursor-acp",
    "antigravity-acp",
    "grok-acp",
    "bounded-delegation"
  ],
  "mcpServers": {
    "cursor-acp": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bridge/acp-runtime/launcher.mjs", "cursor-acp"]
    },
    "antigravity-acp": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bridge/acp-runtime/launcher.mjs", "antigravity-acp"]
    },
    "grok-acp": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bridge/acp-runtime/launcher.mjs", "grok-acp"]
    }
  }
}
