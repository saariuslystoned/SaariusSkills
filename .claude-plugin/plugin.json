  "description": "Experimental agent skills, product decisions, and local Cursor, Antigravity, and Grok ACP delegation routes.",
  "author": {
    "name": "Bobby Bones",
    "url": "https://github.com/saariuslystoned"
  },
  "homepage": "https://github.com/saariuslystoned/SaariusSkills",
